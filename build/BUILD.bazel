package(default_visibility = ["//visibility:public"])

load(":fix_settings.bzl", "fix_cache", "fix_jobs")
load("@rules_python//python:defs.bzl", "py_binary")
load("@local_tools//:cores.bzl", "HOST_FIX_CACHE")

fix_jobs(name = "fix-jobs", build_setting_default = 0)

py_binary(name = "ndjson", srcs = ["ndjson.py"])

fix_cache(name = "fix-cache", build_setting_default = HOST_FIX_CACHE)
py_binary(name = "fix-action", srcs = ["fix_action.py"], main = "fix_action.py")
py_binary(name = "fix-cache-reset", srcs = ["fix_action.py"], main = "fix_action.py", args = ["--reset"], toolchains = [":fix-cache"], env = {"FIX_CACHE": "$(FIX_CACHE)"})

exports_files([
    "cc.bzl",
    "fix.bzl",
    "FIX.md",
    "cc_checks.bzl",
    "repositories.bzl",
    "llvm_configure.bzl",
    "rules_rust.patch",
    "blake3-custom-target.patch",
    "defs.bzl",
    "hedron-bazel9.patch",
    "wabt.BUILD.bazel",
    "wabt-externref.cmake",
    "rocq.bzl",
    "rocq-toolchain.opam",
    "rocq-toolchain.opam.locked",
    "rocq_toolchain.py",
    "rocq_toolchain.bzl",
])

load("@rules_rust//rust:defs.bzl", "rust_binary")

exports_files(["fix_run.rs"])
rust_binary(
    name = "fix_test",
    srcs = ["fix_test.rs"],
    edition = "2024",
    deps = ["@crates//:hex", "@rules_rust//tools/runfiles"],
)

py_binary(name = "rocq_dependencies", srcs = ["rocq_dependencies.py"])
