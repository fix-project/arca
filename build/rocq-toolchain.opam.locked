  "coqide-server" {= "9.1.1"}
  "cppo" {= "1.8.0"}
  "csexp" {= "1.5.2"}
  "dune" {= "3.23.1"}
  "dune-configurator" {= "3.23.1"}
  "easy-format" {= "1.3.4"}
  "elpi" {= "3.7.3"}
