  "ppx_optcomp" {= "v0.17.1"}
  "ppxlib" {= "0.38.0"}
  "re" {= "1.14.0"}
  "rocq-core" {= "9.1.1"}
  "rocq-elpi" {= "3.5.1"}
  "rocq-hierarchy-builder" {= "1.10.3"}
  "rocq-mathcomp-ssreflect" {= "2.4.0"}
  "rocq-parseque" {= "0.3.1"}
  "rocq-runtime" {= "9.1.1"}
  "rocq-stdlib" {= "9.0.0"}
  "sexplib0" {= "v0.17.0"}
