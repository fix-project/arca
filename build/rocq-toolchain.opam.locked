  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
  "ocaml" {= "5.5.1"}
  "ocaml-base-compiler" {= "5.5.1"}
  "ocaml-compiler" {= "5.5.1"}
  "ocaml-compiler-libs" {= "v0.17.0"}
