load("@rules_rust//rust:toolchain.bzl", "rust_toolchain", "rust_stdlib_filegroup")
load(":arca.bzl", "ARCA_TARGET", "arca_target")

package(default_visibility = ["//visibility:public"])

constraint_setting(name = "arca_mode")

constraint_value(
    name = "kernel_mode",
    constraint_setting = ":arca_mode",
)

constraint_value(
    name = "user_mode",
    constraint_setting = ":arca_mode",
)

platform(
    name = "host",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "arca",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
        ":kernel_mode",
    ],
)

platform(
    name = "arca_user",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
        ":user_mode",
    ],
)

platform(
    name = "wasm",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:none",
    ],
)

config_setting(
    name = "linux",
    constraint_values = ["@platforms//os:linux"],
)

config_setting(
    name = "bare_metal",
    constraint_values = [":kernel_mode"],
)

# The objects in cc_import are freestanding x86-64 archives produced by explicit
# actions. Reuse the host binutils descriptions for CcInfo; Rust links Arca
# images with its bundled rust-lld and the supplied linker script, without CRT.
toolchain(
    name = "arca_cc",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:none",
    ],
    toolchain = "@local_config_cc//:cc-compiler-k8",
    toolchain_type = "@rules_cc//cc:toolchain_type",
)

# Use a freestanding linker for both modes. Userspace uses the System V ABI
# (including SIMD); the kernel uses the soft-float ABI of x86_64-unknown-none.
[
    rust_toolchain(
        name = name + "_impl",
        binary_ext = "",
        cargo = tools + ":cargo",
        cargo_clippy = tools + ":cargo_clippy_bin",
        channel = "nightly",
        clippy_driver = tools + ":clippy_driver_bin",
        default_edition = "2024",
        dylib_ext = ".so",
        exec_triple = "x86_64-unknown-linux-gnu",
        extra_rustc_flags = [
            "-Cforce-frame-pointers=on",
            "-Ccode-model=large",
            "-Crelocation-model=static",
        ] + flags,
        iso_date = "2026-09-28",
        linker = tools + ":rust-lld",
        linker_preference = "rust",
        linker_type = "direct",
        rust_doc = tools + ":rustdoc",
        rust_std = ":user_std" if name == "arca_user_rust" else tools + ":rust_std-" + triple,
        rustc = tools + ":rustc",
        rustc_lib = tools + ":rustc_lib",
        rustfmt = tools + ":rustfmt_bin",
        staticlib_ext = ".a",
        stdlib_linkflags = [],
        target_triple = triple if name == "arca_rust" else None,
        target_json = json.encode(ARCA_TARGET) if name == "arca_user_rust" else None,
        target_json_name = "x86_64-unknown-arca.json" if name == "arca_user_rust" else "",
        version = "1.100.0",
    )
    for name, tools, triple, flags in [
        ("arca_rust", "@arca_rust_tools//", "x86_64-unknown-none", []),
        ("arca_user_rust", "@arca_rust_tools//", "x86_64-unknown-arca", ["-Zunstable-options"]),
    ]
]

[
    toolchain(
        name = name,
        exec_compatible_with = [
            "@platforms//cpu:x86_64",
            "@platforms//os:linux",
        ],
        target_compatible_with = [
            "@platforms//cpu:x86_64",
            "@platforms//os:none",
            mode,
        ],
        toolchain = ":" + name + "_impl",
        toolchain_type = "@rules_rust//rust:toolchain_type",
    )
    for name, mode in [("arca_rust", ":kernel_mode"), ("arca_user_rust", ":user_mode")]
]

arca_target(name = "user_target")

genrule(
    name = "build_user_std",
    srcs = [
        ":user_target",
        "@rust_src//:sources",
        "@rust_src//:core/src/lib.rs",
    ],
    outs = ["libcore.rlib", "liballoc.rlib", "libcompiler_builtins.rlib"],
    tools = [
        ":build_std.sh",
        "@arca_rust_tools//:rustc",
        "@arca_rust_tools//:rustc_lib",
        "@host_rust_tools//:rust_std-x86_64-unknown-linux-gnu",
    ],
    cmd = "bash $(location :build_std.sh) $(location @arca_rust_tools//:rustc) " +
          "$(location @rust_src//:core/src/lib.rs) $(location :user_target) $(@D) " +
          "$(locations @host_rust_tools//:rust_std-x86_64-unknown-linux-gnu)",
)

rust_stdlib_filegroup(
    name = "user_std",
    srcs = [":build_user_std"],
)
