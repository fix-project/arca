load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build:cc.bzl", "cc_object")
package(default_visibility = ["//visibility:public"])

genrule(
    name = "reference",
    srcs = ["@mt19937_src//file"],
    outs = ["mt19937-64.c"],
    cmd = "cp $< $@",
)

cc_library(
    name = "mt19937",
    srcs = ["mt19937.c"],
    hdrs = ["mt19937.h", ":reference"],
    includes = ["."],
    copts = ["-std=c17"],
)

cc_object(
    name = "wasm",
    src = "mt19937.c",
    hdrs = ["mt19937.h", "stdio.h"],
    include_roots = [":reference"],
    compiler = "@local_tools//:clang",
    copts = ["--target=wasm32", "-std=c17", "-O2", "-ffreestanding", "-fno-builtin", "-Ithird_party/mt19937"],
)
