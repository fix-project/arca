load("//fix/sdk:defs.bzl", "fix_cc_wasm")
load("//build:defs.bzl", "wat_module")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

package(default_visibility = ["//visibility:public"])

fix_cc_wasm(
    name = "adapter_wasm",
    srcs = ["c/main.c", "c/bytes.c", "c/filesystem.c", "c/wasi.c"],
    hdrs = ["c/flatware.h", "//third_party/mt19937:mt19937.h"],
    link_inputs = ["//third_party/dlmalloc:wasm", "//third_party/mt19937:wasm"],
    copts = ["-I.", "-std=c17", "-Wall", "-Wextra", "-Werror"],
    memories = 2,
)

rust_binary(
    name = "check_resources",
    srcs = ["resources.rs"],
    deps = ["@crates//:anyhow", "@crates//:wasmparser"],
)

wat_module(name = "control_wasm", src = "control.wat", out = "control.wasm", visibility = ["//visibility:public"])

genrule(
    name = "merged_wasm",
    srcs = [":adapter_wasm", ":control_wasm"],
    tools = ["//tools:wasm_merge"],
    outs = ["flatware.wasm"],
    cmd = "$(execpath //tools:wasm_merge) $(location :adapter_wasm) wasi_snapshot_preview1 $(location :control_wasm) flatware_control --rename-export-conflicts -o $@",
)

rust_library(
    name = "tree",
    srcs = ["tree.rs"],
    crate_name = "flatware_tree",
    crate_root = "tree.rs",
    edition = "2024",
    deps = ["//fix/handle", "//fix/repository"],
)
