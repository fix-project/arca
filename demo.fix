{- 
    -- The program consists of a list of varible-expression assignments,
    -- ending with a single expression, which is the result of the program.

    -- Assignments tie expression values to variable names
    x = 42u8

    -- Expressions consist of:

    -- Integer Literals
    42u8

    -- String Literals
    "hello"

    -- Trees
    (1u8 2u8 3u8)

    -- References
    &"hello"

    -- Identification Thunks
    '&4u8

    -- Application Thunks
    #(1u8 2u8)

    -- Selection Thunks
    ["hello" 2u8] -- Zero-indexed
    ["hello" 1u8 3u8] -- Inclusive start and exclusive end

    -- Strict Encodes
    *'&2u8

    -- Shallow Encodes
    +'&2u8

    -- @ contents of a file in the host filesystem
    @"./target/x86_64-unknown-none/addblob"

    -- Primitives
    *#($identity 2u8)

-}