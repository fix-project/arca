(module
  (import "fix" "invalidate_externrefs" (func $invalidate (param externref) (result externref)))
  (import "fix" "get_tree_element" (func $get (param externref i32) (result externref)))
  (import "fix" "create_blob" (func $blob (param i32 i32) (result externref)))
  (import "fix" "create_tree" (func $tree (param i32 i32) (result externref)))
  (import "fix" "create_ref" (func $ref (param externref) (result externref)))
  (import "fix" "attach_blob" (func $attach_blob (param externref i32)))
  (import "fix" "attach_tree" (func $attach_tree (param externref i32)))
  (import "fix" "detach_tree" (func $detach_tree (param i32 i32)))
  (import "fix" "equals" (func $equals (param externref externref) (result i32)))
  (import "fix" "get_type" (func $type (param externref) (result i32)))
  (import "fix" "len" (func $len (param externref) (result i64)))
  (import "fix" "effect" (func $effect (param externref) (result externref)))
  (memory $source 1)
  (memory $attached 0)
  (table $values 4 externref)
  (table $view 0 externref)
  (table $detached 0 externref)
  (table $roots 4 externref)
  (table $empty 0 externref)
  (func $assert (param $condition i32)
    (if (i32.eqz (local.get $condition)) (then unreachable)))
  (func (export "_fix_apply") (param $combination externref) (result externref)
    (local $keep externref) (local $argument externref) (local $graph externref)
    (local $request externref) (local $round i32) (local $index i32)
    (local.set $argument (call $get (local.get $combination) (i32.const 2)))
    (call $attach_blob (local.get $argument) (i32.const 1))
    (memory.fill $source (i32.const 0) (i32.const 7) (i32.const 64))
    (table.set $values (i32.const 0) (call $blob (i32.const 0) (i32.const 64)))
    (table.set $values (i32.const 1) (call $ref (table.get $values (i32.const 0))))
    (table.set $values (i32.const 2) (local.get $argument))
    (local.set $graph (call $tree (i32.const 0) (i32.const 4)))
    (call $attach_tree (local.get $graph) (i32.const 1))
    (call $attach_tree (local.get $graph) (i32.const 2))
    (call $detach_tree (i32.const 2) (i32.const 1))
    (table.set $roots (i32.const 0) (local.get $combination))
    (table.set $roots (i32.const 1) (local.get $graph))
    (table.set $roots (i32.const 2) (call $ref (local.get $graph)))
    (table.set $values (i32.const 0) (call $blob (i32.const 0) (i32.const 64)))
    (table.set $roots (i32.const 3) (call $tree (i32.const 0) (i32.const 4)))
    (local.set $keep (call $tree (i32.const 3) (i32.const 4)))
    (loop $rounds
      (local.set $index (i32.const 0))
      (loop $garbage
        (drop (call $blob (i32.const 0) (i32.const 64)))
        (drop (call $ref (local.get $argument)))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br_if $garbage (i32.lt_u (local.get $index) (i32.const 2048))))
      (local.set $keep (call $invalidate (local.get $keep)))
      (local.set $combination (call $get (local.get $keep) (i32.const 0)))
      (local.set $argument (call $get (local.get $combination) (i32.const 2)))
      (local.set $request (call $get (local.get $combination) (i32.const 3)))
      (call $assert (i32.eq (i32.load8_u $attached (i32.const 63)) (i32.const 42)))
      (call $assert (call $equals (table.get $view (i32.const 2)) (local.get $argument)))
      (call $assert (call $equals (table.get $detached (i32.const 2)) (local.get $argument)))
      (call $assert (i32.eq (call $type (table.get $values (i32.const 1))) (i32.const 1)))
      (call $assert (i32.eq (call $type (call $get (local.get $keep) (i32.const 2))) (i32.const 1)))
      (call $assert (i64.eq (call $len (call $get (local.get $keep) (i32.const 3))) (i64.const 4)))
      (call $assert (ref.is_null (table.get $view (i32.const 3))))
      (call $assert (i32.eqz (table.size $empty)))
      (drop (call $effect (local.get $request)))
      (local.set $round (i32.add (local.get $round) (i32.const 1)))
      (br_if $rounds (i32.lt_u (local.get $round) (i32.const 2))))
    (local.set $keep (call $invalidate (ref.null extern)))
    (call $assert (ref.is_null (local.get $keep)))
    (table.get $view (i32.const 2))))
