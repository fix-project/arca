(module
  (import "fix" "close" (func $close (param i32)))
  (import "fix" "create_ref" (func $ref (param i32) (result i32)))
  (import "fix" "create_tree" (func $tree (param i32 i32) (result i32)))
  (import "fix" "coordinate_handles" (func $coordinate (param i32 i32 i32 i32 i32) (result i32)))
  (memory 1)
  (data (i32.const 0) "get_blob")
  (data (i32.const 16) "storage_evict")
  (func $evict (param $ref i32)
    (i32.store (i32.const 32) (local.get $ref))
    (call $close (call $coordinate (i32.const 16) (i32.const 13) (i32.const 32) (i32.const 1) (i32.const 40))))
  (func (export "_fix_apply") (param i32) (result i32)
    (local $blob i32)
    (local $tree i32)
    (local $ref i32)
    (local.set $blob (call $coordinate (i32.const 0) (i32.const 8) (i32.const 32) (i32.const 0) (i32.const 40)))
    (local.set $ref (call $ref (local.get $blob)))
    (i32.store (i32.const 32) (local.get $blob))
    (local.set $tree (call $tree (i32.const 32) (i32.const 1)))
    (call $close (local.get $blob))
    (call $evict (local.get $ref))
    (call $close (local.get $tree))
    (call $evict (local.get $ref))
    (local.get $ref)))
