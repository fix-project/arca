(module
  (import "fix" "get_tree_element" (func $get (param externref i32) (result externref)))
  (import "fix" "attach_tree" (func $attach_tree (param externref i32)))
  (import "fix" "attach_blob" (func $attach_blob (param externref i32)))
  (import "fix" "create_blob_i64" (func $integer (param i64) (result externref)))
  (import "fix" "create_ref" (func $ref (param externref) (result externref)))
  (import "fix" "get_type" (func $type (param externref) (result i32)))
  (import "fix" "effect" (func $effect (param externref) (result externref)))
  (memory 0)
  (table 0 externref)
  (func (export "_fix_apply") (param $combination externref) (result externref) (local $remaining i64)
    (call $attach_blob (call $get (local.get $combination) (i32.const 2)) (i32.const 0))
    (local.set $remaining (i64.load (i32.const 0)))
    (loop $again
      (call $attach_tree (local.get $combination) (i32.const 0))
      (drop (call $type (call $ref (table.get (i32.const 1)))))
      (drop (call $get (local.get $combination) (i32.const 1)))
      (drop (call $integer (local.get $remaining)))
      (local.set $remaining (i64.sub (local.get $remaining) (i64.const 1)))
      (br_if $again (i64.ne (local.get $remaining) (i64.const 0))))
    (call $effect (call $integer (i64.const 0)))))
