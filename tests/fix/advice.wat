(module
  (import "fix" "advise" (func $advise (param externref i32 i32 i32 i32)))
  (import "fix" "create_blob" (func $blob (param i32 i32) (result externref)))
  (import "fix" "create_tree" (func $tree (param i32 i32) (result externref)))
  (memory 1)
  (memory $contents 1)
  (table 2 externref)
  (data (i32.const 0) "fix::title")
  (data (i32.const 16) "fix::progress")
  (data (i32.const 40) "sample::binary")
  (data (i32.const 104) "sample::local")
  (data (memory $contents) (i32.const 0) "freshly constructed advice target contents")
  (data (i32.const 64) "probe")
  (data (i32.const 72) "first")
  (data (i32.const 80) "last")
  (data (i32.const 88) "\00\ff")
  (func (export "_fix_apply") (param $input externref) (result externref)
    (call $advise (local.get $input) (i32.const 0) (i32.const 10) (i32.const 64) (i32.const 5))
    (call $advise (local.get $input) (i32.const 16) (i32.const 13) (i32.const 72) (i32.const 5))
    (call $advise (local.get $input) (i32.const 16) (i32.const 13) (i32.const 80) (i32.const 4))
    (call $advise (local.get $input) (i32.const 40) (i32.const 14) (i32.const 88) (i32.const 2))
    (table.set (i32.const 0) (call $blob (i32.const 1) (i32.const 42)))
    (call $advise (table.get (i32.const 0)) (i32.const 104) (i32.const 13) (i32.const 64) (i32.const 5))
    (table.set (i32.const 1) (local.get $input))
    (call $advise (call $tree (i32.const 0) (i32.const 2)) (i32.const 104) (i32.const 13) (i32.const 64) (i32.const 5))
    (memory.fill $contents (i32.const 0) (i32.const 0) (i32.const 42))
    (table.set (i32.const 0) (ref.null extern))
    (table.set (i32.const 1) (ref.null extern))
    (local.get $input)))
