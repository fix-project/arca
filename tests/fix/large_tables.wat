(module
  (import "fix" "get_tree_element" (func $get (param externref i32) (result externref)))
  (import "fix" "attach_tree" (func $attach_tree (param externref i32)))
  (import "fix" "create_tree" (func $tree (param i32 i32) (result externref)))
  (import "fix" "equals" (func $equals (param externref externref) (result i32)))
  (import "fix" "effect" (func $effect (param externref) (result externref)))
  (table $initial 65537 externref)
  (table $grown 0 externref)
  (table $view 0 externref)
  (func $assert (param $condition i32)
    (if (i32.eqz (local.get $condition)) (then unreachable)))
  (func (export "_fix_apply") (param $combination externref) (result externref)
    (local $argument externref) (local $request externref)
    (local $initial_snapshot externref) (local $grown_snapshot externref)
    (local $page_snapshot externref) (local $table_snapshot externref)
    (local.set $argument (call $get (local.get $combination) (i32.const 2)))
    (local.set $request (call $get (local.get $combination) (i32.const 3)))
    (table.fill $initial (i32.const 0) (local.get $argument) (i32.const 65537))
    (call $assert (i32.eq (table.grow $grown (local.get $argument) (i32.const 65537)) (i32.const 0)))
    (local.set $page_snapshot (call $tree (i32.const 0) (i32.const 128)))
    (local.set $table_snapshot (call $tree (i32.const 0) (i32.const 129)))
    (local.set $initial_snapshot (call $tree (i32.const 0) (i32.const 65536)))
    (local.set $grown_snapshot (call $tree (i32.const 1) (i32.const 65537)))
    (table.fill $initial (i32.const 0) (ref.null extern) (i32.const 65537))
    (table.fill $grown (i32.const 0) (ref.null extern) (i32.const 65537))
    (drop (call $effect (local.get $request)))
    (call $attach_tree (local.get $page_snapshot) (i32.const 2))
    (call $assert (i32.eq (table.size $view) (i32.const 128)))
    (call $assert (call $equals (table.get $view (i32.const 127)) (local.get $argument)))
    (call $attach_tree (local.get $table_snapshot) (i32.const 2))
    (call $assert (i32.eq (table.size $view) (i32.const 129)))
    (call $assert (call $equals (table.get $view (i32.const 128)) (local.get $argument)))
    (call $attach_tree (local.get $initial_snapshot) (i32.const 2))
    (call $assert (i32.eq (table.size $view) (i32.const 65536)))
    (call $assert (call $equals (table.get $view (i32.const 0)) (local.get $argument)))
    (call $assert (call $equals (table.get $view (i32.const 65535)) (local.get $argument)))
    (call $attach_tree (local.get $grown_snapshot) (i32.const 2))
    (call $assert (i32.eq (table.size $view) (i32.const 65537)))
    (drop (call $effect (local.get $request)))
    (call $assert (ref.is_null (table.get $initial (i32.const 65536))))
    (call $assert (ref.is_null (table.get $grown (i32.const 65536))))
    (call $assert (call $equals (table.get $view (i32.const 0)) (local.get $argument)))
    (call $assert (call $equals (table.get $view (i32.const 65536)) (local.get $argument)))
    (local.get $argument)))
