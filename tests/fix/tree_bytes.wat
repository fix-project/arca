(module
  (import "fix" "create_blob_i64" (func $literal (param i64) (result i32)))
  (import "fix" "create_tree" (func $tree (param i32 i32) (result i32)))
  (import "fix" "attach_tree_bytes" (func $attach (param i32 i32)))
  (import "fix" "detach_blob" (func $detach (param i32 i32)))
  (import "fix" "close" (func $close (param i32)))
  (memory 1)
  (memory 0)
  (func (export "_fix_apply") (param i32) (result i32)
    (local $fields i32)
    (local $result i64)
    (i32.store (i32.const 0) (call $literal (i64.const 42)))
    (i32.store (i32.const 4) (call $literal (i64.const 43)))
    (local.set $fields (call $tree (i32.const 0) (i32.const 2)))
    (call $attach (local.get $fields) (i32.const 1))
    (call $close (local.get $fields))
    (local.set $result
      (i64.add (i64.load 1 (i32.const 0)) (i64.load 1 (i32.const 32))))
    (call $detach (i32.const 1) (i32.const 0))
    (call $literal (local.get $result))))
