(module
  (import "fix" "get_tree_element" (func $get (param externref i32) (result externref)))
  (import "fix" "attach_blob" (func $attach_blob (param externref i32)))
  (import "fix" "detach_blob" (func $detach_blob (param i32 i32)))
  (import "fix" "attach_tree" (func $attach_tree (param externref i32)))
  (import "fix" "detach_tree" (func $detach_tree (param i32 i32)))
  (import "fix" "create_blob" (func $blob (param i32 i32) (result externref)))
  (import "fix" "create_blob_i64" (func $integer (param i64) (result externref)))
  (import "fix" "create_tree" (func $tree (param i32 i32) (result externref)))
  (import "fix" "create_tag" (func $tag (param i32) (result externref)))
  (import "fix" "create_ref" (func $ref (param externref) (result externref)))
  (import "fix" "create_identification_thunk" (func $identify (param externref) (result externref)))
  (import "fix" "create_application_thunk" (func $apply (param externref) (result externref)))
  (import "fix" "create_selection_thunk" (func $select (param externref) (result externref)))
  (import "fix" "create_strict_encode" (func $strict (param externref) (result externref)))
  (import "fix" "create_shallow_encode" (func $shallow (param externref) (result externref)))
  (import "fix" "get_type" (func $type (param externref) (result i32)))
  (import "fix" "get_data_type" (func $data_type (param externref) (result i32)))
  (import "fix" "get_encode_type" (func $encode_type (param externref) (result i32)))
  (import "fix" "len" (func $len (param externref) (result i64)))
  (import "fix" "is_tag" (func $is_tag (param externref) (result i32)))
  (import "fix" "is_comparable" (func $comparable (param externref) (result i32)))
  (import "fix" "equals" (func $equals (param externref externref) (result i32)))
  (import "fix" "effect" (func $effect (param externref) (result externref)))
  (import "fix" "return_cc" (func $return_cc (param externref) (result externref)))
  (type $unary (func (param i32) (result i32)))
  (memory $control 0)
  (memory $working 1)
  (table $values 16 externref)
  (table $functions 1 4 funcref)
  (table $empty 0 externref)
  (table $view 0 externref)
  (table $tag_fields 1 externref)
  (global $remembered (mut externref) (ref.null extern))
  (global $counter (mut i32) (i32.const 0))
  (func $increment (type $unary) (param $value i32) (result i32)
    (i32.add (local.get $value) (global.get $counter)))
  (elem (table $functions) (i32.const 0) func $increment)
  (func $assert (param $condition i32)
    (if (i32.eqz (local.get $condition)) (then unreachable)))
  (func $suspend (param $request externref) (param $mode i64)
    (global.set $counter (i32.add (global.get $counter) (i32.const 1)))
    (if (i64.eq (local.get $mode) (i64.const 4))
      (then (drop (call $return_cc (local.get $request))))
      (else (drop (call $effect (local.get $request))))))
  (func $check
    (call $assert (i32.eqz (call $type (table.get $values (i32.const 0)))))
    (call $assert (i32.eq (call $type (table.get $values (i32.const 1))) (i32.const 1)))
    (call $assert (i32.eq (call $type (table.get $values (i32.const 2))) (i32.const 2)))
    (call $assert (i32.eq (call $type (table.get $values (i32.const 3))) (i32.const 3)))
    (call $assert (i32.eqz (call $encode_type (table.get $values (i32.const 3)))))
    (call $assert (i32.eq (call $encode_type (table.get $values (i32.const 4))) (i32.const 1)))
    (call $assert (i32.eq (call $data_type (table.get $values (i32.const 6))) (i32.const 1)))
    (call $assert (i32.eqz (call $comparable (table.get $values (i32.const 6)))))
    (call $assert (i64.eq (call $len (table.get $values (i32.const 1))) (i64.const 64)))
    (call $assert (i64.eqz (call $len (table.get $values (i32.const 11)))))
    (call $assert (call $is_tag (table.get $values (i32.const 13))))
    (call $assert (ref.is_null (table.get $values (i32.const 14)))))
  (func $handles (param $author externref) (param $argument externref) (param $request externref) (param $mode i64) (result externref)
    (local $graph externref)
    (table.set $values (i32.const 0) (local.get $argument))
    (table.set $values (i32.const 1) (call $ref (local.get $argument)))
    (table.set $values (i32.const 2) (call $identify (local.get $argument)))
    (table.set $values (i32.const 3) (call $strict (table.get $values (i32.const 2))))
    (table.set $values (i32.const 4) (call $shallow (table.get $values (i32.const 2))))
    (table.set $values (i32.const 5) (call $integer (i64.const 7)))
    (table.set $values (i32.const 6) (call $tree (i32.const 0) (i32.const 6)))
    (table.set $values (i32.const 7) (call $apply (table.get $values (i32.const 6))))
    (table.set $values (i32.const 8) (call $select (table.get $values (i32.const 6))))
    (table.set $values (i32.const 9) (call $strict (table.get $values (i32.const 7))))
    (table.set $values (i32.const 10) (call $shallow (table.get $values (i32.const 8))))
    (table.set $values (i32.const 11) (call $tree (i32.const 2) (i32.const 0)))
    (table.set $values (i32.const 12) (call $ref (table.get $values (i32.const 11))))
    (table.set $tag_fields (i32.const 0) (local.get $author))
    (table.set $values (i32.const 13) (call $tag (i32.const 4)))
    (table.set $values (i32.const 15) (local.get $argument))
    (local.set $graph (call $tree (i32.const 0) (i32.const 16)))
    (global.set $remembered (local.get $argument))
    (call $check)
    (call $suspend (local.get $request) (local.get $mode))
    (call $check)
    (call $attach_tree (local.get $graph) (i32.const 3))
    (call $assert (i32.eq (table.size $view) (i32.const 16)))
    (call $assert (call $equals (table.get $view (i32.const 15)) (global.get $remembered)))
    (call $suspend (local.get $request) (local.get $mode))
    (call $check)
    (call $assert (i32.eq (call_indirect $functions (type $unary) (i32.const 40) (i32.const 0)) (i32.const 42)))
    (global.get $remembered))
  (func $attachments (param $argument externref) (param $request externref) (result externref)
    (local $modified externref) (local $graph externref)
    (call $attach_blob (local.get $argument) (i32.const 0))
    (call $detach_blob (i32.const 0) (i32.const 1))
    (i32.store8 $control (i32.const 63) (i32.const 99))
    (call $assert (i32.eq (memory.grow $control (i32.const 1)) (i32.const 1)))
    (local.set $modified (call $blob (i32.const 0) (i32.const 128)))
    (table.set $values (i32.const 0) (local.get $argument))
    (table.set $values (i32.const 1) (local.get $modified))
    (local.set $graph (call $tree (i32.const 0) (i32.const 2)))
    (call $attach_tree (local.get $graph) (i32.const 3))
    (call $detach_tree (i32.const 3) (i32.const 1))
    (call $assert (i32.eq (table.grow $view (local.get $argument) (i32.const 129)) (i32.const 2)))
    (table.set $view (i32.const 0) (ref.null extern))
    (call $assert (i32.eq (table.grow $functions (ref.func $increment) (i32.const 2)) (i32.const 1)))
    (call $suspend (local.get $request) (i64.const 1))
    (call $assert (i32.eq (i32.load8_u $control (i32.const 63)) (i32.const 99)))
    (call $attach_blob (local.get $argument) (i32.const 1))
    (call $assert (i32.eq (i32.load8_u $working (i32.const 63)) (i32.const 42)))
    (call $detach_blob (i32.const 1) (i32.const 0))
    (call $attach_blob (local.get $modified) (i32.const 1))
    (call $assert (i32.eq (i32.load8_u $working (i32.const 63)) (i32.const 99)))
    (call $suspend (local.get $request) (i64.const 1))
    (call $assert (i32.eq (memory.size $control) (i32.const 2)))
    (call $assert (i32.eq (table.size $view) (i32.const 131)))
    (call $assert (ref.is_null (table.get $view (i32.const 0))))
    (call $assert (call $equals (table.get $view (i32.const 130)) (local.get $argument)))
    (call $assert (i32.eq (call_indirect $functions (type $unary) (i32.const 40) (i32.const 2)) (i32.const 42)))
    (local.get $argument))
  (func $replies (param $argument externref) (param $request externref) (result externref)
    (local $reply externref)
    (local.set $reply (call $effect (local.get $request)))
    (call $assert (call $equals (local.get $reply) (local.get $argument)))
    (global.set $remembered (local.get $reply))
    (table.set $values (i32.const 0) (call $ref (local.get $reply)))
    (call $attach_blob (local.get $reply) (i32.const 0))
    (call $assert (i32.eq (i32.load8_u $control (i32.const 63)) (i32.const 42)))
    (drop (call $effect (local.get $request)))
    (call $assert (call $equals (global.get $remembered) (local.get $argument)))
    (local.get $argument))
  (func (export "_fix_apply") (param $combination externref) (result externref)
    (local $argument externref) (local $request externref) (local $mode i64)
    (local.set $argument (call $get (local.get $combination) (i32.const 2)))
    (local.set $request (call $get (local.get $combination) (i32.const 3)))
    (call $attach_blob (call $get (local.get $combination) (i32.const 4)) (i32.const 0))
    (local.set $mode (i64.load $control (i32.const 0)))
    (if (i64.eq (local.get $mode) (i64.const 1))
      (then (return (call $attachments (local.get $argument) (local.get $request)))))
    (if (i64.eq (local.get $mode) (i64.const 3))
      (then (return (call $replies (local.get $argument) (local.get $request)))))
    (call $handles (call $get (local.get $combination) (i32.const 1)) (local.get $argument) (local.get $request) (local.get $mode))))
