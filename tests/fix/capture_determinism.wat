(module
  (import "fix" "get_tree_element" (func $get (param externref i32) (result externref)))
  (import "fix" "attach_blob" (func $attach_blob (param externref i32)))
  (import "fix" "attach_tree" (func $attach_tree (param externref i32)))
  (import "fix" "create_tree" (func $tree (param i32 i32) (result externref)))
  (import "fix" "create_blob_i64" (func $integer (param i64) (result externref)))
  (import "fix" "equals" (func $equals (param externref externref) (result i32)))
  (import "fix" "effect" (func $effect (param externref) (result externref)))
  (tag $saved (param externref))
  (tag $nested (param i32))
  (memory $control 0)
  (table $source 260 400 externref)
  (table $destination 260 externref)
  (table $view 0 externref)
  (elem $nulls externref (ref.null extern) (ref.null extern))
  (func $assert (param $condition i32)
    (if (i32.eqz (local.get $condition)) (then unreachable)))
  (func $catch_capture (param $argument externref) (param $request externref) (result externref)
    (local $value externref) (local $code i32)
    (try (result externref)
      (do
        (try
          (do (throw $saved (local.get $argument)))
          (catch $saved
            (local.set $value)
            (drop (call $effect (local.get $request)))
            (try
              (do (throw $nested (i32.const 7)))
              (catch $nested
                (local.set $code)
                (call $assert (i32.eq (local.get $code) (i32.const 7)))))
            (rethrow 0)))
        unreachable)
      (catch $saved
        (local.set $value)
        (drop (call $effect (local.get $request)))
        (local.get $value))))
  (func $try_capture (param $argument externref) (param $request externref) (result externref)
    (local $value externref)
    (try (result externref)
      (do
        (drop (call $effect (local.get $request)))
        (throw $saved (local.get $argument)))
      (catch $saved
        (local.set $value)
        (drop (call $effect (local.get $request)))
        (local.get $value))))
  (func $table_capture (param $argument externref) (param $request externref) (result externref)
    (local $snapshot externref)
    (table.fill $source (i32.const 0) (local.get $argument) (i32.const 260))
    (table.set $source (i32.const 129) (call $integer (i64.const 7)))
    (table.copy $source $source (i32.const 1) (i32.const 0) (i32.const 128))
    (table.copy $destination $source (i32.const 0) (i32.const 0) (i32.const 260))
    (table.init $destination $nulls (i32.const 128) (i32.const 0) (i32.const 2))
    (local.set $snapshot (call $tree (i32.const 1) (i32.const 260)))
    (table.set $destination (i32.const 0) (ref.null extern))
    (drop (call $effect (local.get $request)))
    (call $attach_tree (local.get $snapshot) (i32.const 2))
    (call $assert (i32.eq (table.size $view) (i32.const 260)))
    (call $assert (call $equals (table.get $view (i32.const 127)) (local.get $argument)))
    (call $assert (ref.is_null (table.get $view (i32.const 128))))
    (call $assert (ref.is_null (table.get $view (i32.const 129))))
    (call $assert (ref.is_null (table.get $destination (i32.const 0))))
    (call $assert (call $equals (table.get $source (i32.const 129)) (call $integer (i64.const 7))))
    (table.copy $source $view (i32.const 0) (i32.const 0) (i32.const 260))
    (table.init $source $nulls (i32.const 127) (i32.const 0) (i32.const 2))
    (call $assert (i32.eq (table.grow $source (local.get $argument) (i32.const 129)) (i32.const 260)))
    (drop (call $effect (local.get $request)))
    (call $assert (i32.eq (table.size $source) (i32.const 389)))
    (call $assert (ref.is_null (table.get $source (i32.const 127))))
    (call $assert (call $equals (table.get $source (i32.const 388)) (local.get $argument)))
    (call $assert (call $equals (table.get $view (i32.const 127)) (local.get $argument)))
    (local.get $snapshot))
  (func $reference_capture (param $argument externref) (param $request externref) (result externref)
    (local $exception exnref) (local $value externref) (local $code i32)
    (block $caught (result externref exnref)
      (try_table (catch_ref $saved $caught) (throw $saved (local.get $argument)))
      unreachable)
    (local.set $exception)
    (local.set $value)
    (drop (call $effect (local.get $request)))
    (try
      (do (throw $nested (i32.const 7)))
      (catch $nested
        (local.set $code)
        (call $assert (i32.eq (local.get $code) (i32.const 7)))))
    (block $caught_again (result externref exnref)
      (try_table (catch_ref $saved $caught_again) (throw_ref (local.get $exception)))
      unreachable)
    (local.set $exception)
    (local.set $value)
    (drop (call $effect (local.get $request)))
    (local.get $value))
  (func (export "_fix_apply") (param $combination externref) (result externref)
    (local $argument externref) (local $request externref) (local $mode i64)
    (local.set $argument (call $get (local.get $combination) (i32.const 2)))
    (local.set $request (call $get (local.get $combination) (i32.const 3)))
    (call $attach_blob (call $get (local.get $combination) (i32.const 4)) (i32.const 0))
    (local.set $mode (i64.load $control (i32.const 0)))
    (if (i64.eqz (local.get $mode))
      (then (return (call $catch_capture (local.get $argument) (local.get $request)))))
    (if (i64.eq (local.get $mode) (i64.const 1))
      (then (return (call $try_capture (local.get $argument) (local.get $request)))))
    (if (i64.eq (local.get $mode) (i64.const 3))
      (then (return (call $reference_capture (local.get $argument) (local.get $request)))))
    (call $table_capture (local.get $argument) (local.get $request))))
