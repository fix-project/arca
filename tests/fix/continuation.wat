(module
  (import "fix" "get_tree_element" (func $get (param externref i32) (result externref)))
  (import "fix" "return_cc" (func $return_cc (param externref) (result externref)))
  (import "fix" "call_cc" (func $call_cc (param externref) (result externref)))
  (import "fix" "attach_tree" (func $attach_tree (param externref i32)))
  (import "fix" "detach_tree" (func $detach_tree (param i32 i32)))
  (import "fix" "attach_blob" (func $attach_blob (param externref i32)))
  (import "fix" "get_data_type" (func $get_data_type (param externref) (result i32)))
  (import "fix" "create_blob_i64" (func $blob (param i64) (result externref)))
  (import "fix" "create_tag" (func $tag (param i32) (result externref)))
  (import "fix" "create_tree" (func $tree (param i32 i32) (result externref)))
  (import "fix" "create_application_thunk" (func $application (param externref) (result externref)))
  (import "fix" "create_ref" (func $ref (param externref) (result externref)))
  (import "fix" "create_identification_thunk" (func $identify (param externref) (result externref)))
  (import "fix" "create_selection_thunk" (func $select (param externref) (result externref)))
  (import "fix" "create_strict_encode" (func $strict (param externref) (result externref)))
  (import "fix" "create_shallow_encode" (func $shallow (param externref) (result externref)))
  (import "fix" "get_type" (func $type (param externref) (result i32)))
  (import "fix" "get_encode_type" (func $encode_type (param externref) (result i32)))
  (import "fix" "is_comparable" (func $comparable (param externref) (result i32)))
  (memory $bytes 0)
  (table $arguments 0 externref)
  (table $tag_fields 1 externref)
  (table $objects 7 externref)
  (table $view 0 externref)
  (global $counter (mut i64) (i64.const 0))
  (func (export "_fix_apply") (param $combination externref) (result externref)
    (local $author externref) (local $depth i64) (local $argument externref) (local $program externref) (local $reply externref) (local $mode i64) (local $saved externref) (local $graph externref)
    (call $attach_tree (local.get $combination) (i32.const 0))
    (local.set $program (table.get $arguments (i32.const 1)))
    (local.set $argument (table.get $arguments (i32.const 2)))
    (if (i32.eq (call $get_data_type (local.get $argument)) (i32.const 1))
      (then
        (call $detach_tree (i32.const 0) (i32.const 1))
        (table.set $arguments (i32.const 1) (local.get $argument))
        (table.set $arguments (i32.const 2) (call $blob (i64.const 41)))
        (return (call $application (call $tree (i32.const 0) (i32.const 3))))))
    (call $attach_blob (local.get $argument) (i32.const 0))
    (local.set $mode (i64.load $bytes (i32.const 0)))
    (table.set $tag_fields (i32.const 0) (call $blob (i64.const 456)))
    (local.set $saved (table.get $tag_fields (i32.const 0)))
    (local.set $graph (call $tree (i32.const 1) (i32.const 1)))
    (table.set $objects (i32.const 0) (local.get $graph))
    (table.set $objects (i32.const 1) (call $ref (local.get $graph)))
    (table.set $objects (i32.const 2) (call $application (local.get $graph)))
    (table.set $objects (i32.const 3) (call $strict (table.get $objects (i32.const 2))))
    (table.set $objects (i32.const 4) (call $shallow (table.get $objects (i32.const 2))))
    (table.set $objects (i32.const 5) (call $identify (local.get $saved)))
    (table.set $objects (i32.const 6) (call $select (local.get $graph)))
    (local.set $graph (call $tree (i32.const 2) (i32.const 7)))
    (if (call $comparable (local.get $graph)) (then unreachable))
    (if (result externref) (i64.eq (local.get $mode) (i64.const 1))
      (then (call $call_cc (local.get $program)))
      (else (call $return_cc (call $blob (i64.const 123)))))
    (local.set $reply)
    (global.set $counter (i64.add (global.get $counter) (i64.const 1)))
    (if (i64.ne (i64.load $bytes (i32.const 0)) (local.get $mode)) (then unreachable))
    (if (i32.ne (call $get_data_type (table.get $arguments (i32.const 1))) (i32.const 1)) (then unreachable))
    (call $attach_tree (local.get $graph) (i32.const 3))
    (if (i32.ne (table.size $view) (i32.const 7)) (then unreachable))
    (if (call $type (table.get $view (i32.const 0))) (then unreachable))
    (if (i32.ne (call $type (table.get $view (i32.const 1))) (i32.const 1)) (then unreachable))
    (if (i32.ne (call $type (table.get $view (i32.const 2))) (i32.const 2)) (then unreachable))
    (if (i32.ne (call $type (table.get $view (i32.const 3))) (i32.const 3)) (then unreachable))
    (if (call $encode_type (table.get $view (i32.const 3))) (then unreachable))
    (if (i32.ne (call $encode_type (table.get $view (i32.const 4))) (i32.const 1)) (then unreachable))
    (if (i32.ne (call $type (table.get $view (i32.const 5))) (i32.const 2)) (then unreachable))
    (if (i32.ne (call $type (table.get $view (i32.const 6))) (i32.const 2)) (then unreachable))
    (call $attach_tree (table.get $view (i32.const 0)) (i32.const 3))
    (call $attach_blob (table.get $view (i32.const 0)) (i32.const 0))
    (if (i64.ne (i64.load $bytes (i32.const 0)) (i64.const 456)) (then unreachable))
    (call $attach_blob (table.get $tag_fields (i32.const 0)) (i32.const 0))
    (if (i64.ne (i64.load $bytes (i32.const 0)) (i64.const 456)) (then unreachable))
    (table.set $tag_fields (i32.const 0) (call $blob (i64.const 457)))
    (call $attach_blob (local.get $saved) (i32.const 0))
    (if (i64.ne (i64.load $bytes (i32.const 0)) (i64.const 456)) (then unreachable))
    (call $attach_blob (table.get $tag_fields (i32.const 0)) (i32.const 0))
    (if (i64.ne (i64.load $bytes (i32.const 0)) (i64.const 457)) (then unreachable))
    (if (i64.eq (local.get $mode) (i64.const 2))
      (then
        (local.set $reply (call $return_cc (local.get $reply)))
        (global.set $counter (i64.add (global.get $counter) (i64.const 1)))))
    (if (i64.ge_u (local.get $mode) (i64.const 3))
      (then
        (local.set $author (local.get $combination))
        (local.set $depth (i64.sub (local.get $mode) (i64.const 3)))
        (block $done (loop $next
          (br_if $done (i64.eqz (local.get $depth)))
          (local.set $author (call $get (local.get $author) (i32.const 1)))
          (local.set $depth (i64.sub (local.get $depth) (i64.const 1)))
          (br $next)))
        (table.set $tag_fields (i32.const 0) (local.get $author))
        (return (call $tag (i32.const 1)))))
    (call $attach_blob (local.get $reply) (i32.const 0))
    (call $blob (i64.add (i64.load $bytes (i32.const 0)) (global.get $counter)))))
