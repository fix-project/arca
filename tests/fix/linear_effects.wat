(module
  (import "fix" "get_tree_element" (func $get (param externref i32) (result externref)))
  (import "fix" "effect" (func $effect (param externref) (result externref)))
  (import "fix" "attach_blob" (func $attach (param externref i32)))
  (import "fix" "create_blob_i64" (func $blob (param i64) (result externref)))
  (import "fix" "create_tree" (func $tree (param i32 i32) (result externref)))
  (import "fix" "create_tag" (func $tag (param i32) (result externref)))
  (import "fix" "unsound_handle_bytes" (func $bytes (param externref) (result externref)))
  (memory $reply 0)
  (table $saved 1 externref)
  (table $fields 1 externref)
  (func (export "_fix_apply") (param $combination externref) (result externref)
    (local $index i64) (local $mode i64)
    (table.set $saved (i32.const 0) (call $get (local.get $combination) (i32.const 2)))
    (call $attach (call $get (local.get $combination) (i32.const 3)) (i32.const 0))
    (local.set $mode (i64.load $reply (i32.const 0)))
    (if (i64.ge_u (local.get $mode) (i64.const 3))
      (then
        (drop (table.grow $saved (table.get $saved (i32.const 0)) (i32.const 65536)))))
    (loop $again
      (call $attach (call $effect (table.get $saved (i32.const 0))) (i32.const 0))
      (if (i64.ne (i64.load $reply (i32.const 0)) (local.get $index)) (then unreachable))
      (if (i64.ge_u (local.get $mode) (i64.const 3))
        (then
          (if (i32.ne (table.size $saved) (i32.const 65537)) (then unreachable))
          (if (ref.is_null (table.get $saved (i32.const 65536))) (then unreachable))
          (table.set $saved (i32.const 65535) (table.get $saved (i32.const 65536)))))
      (local.set $index (i64.add (local.get $index) (i64.const 1)))
      (br_if $again (i64.lt_u (local.get $index) (i64.const 64))))
    (if (i64.eq (local.get $mode) (i64.const 1))
      (then (return (call $bytes (table.get $saved (i32.const 0))))))
    (if (i32.or (i64.eq (local.get $mode) (i64.const 2)) (i64.eq (local.get $mode) (i64.const 4)))
      (then
        (table.set $fields (i32.const 0) (local.get $combination))
        (return (call $tag (i32.const 1)))))
    (call $blob (local.get $index))))
