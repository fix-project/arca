(module
  (import "fix" "effect" (func $effect (param externref) (result externref)))
  (import "fix" "create_blob" (func $blob (param i32 i32) (result externref)))
  (import "fix" "create_tree" (func $tree (param i32 i32) (result externref)))
  (import "fix" "create_ref" (func $ref (param externref) (result externref)))
  (import "fix" "create_identification_thunk" (func $identify (param externref) (result externref)))
  (import "fix" "create_strict_encode" (func $strict (param externref) (result externref)))
  (memory $bytes 1)
  (table $request 4 externref)
  (table $hidden 2 externref)
  (table $output 3 externref)
  (func (export "_fix_apply") (param externref) (result externref)
    (local $leaf externref) (local $alias externref) (local $request externref)
    (local $hidden_blob externref) (local $hidden_tree externref)
    (memory.fill $bytes (i32.const 0) (i32.const 7) (i32.const 64))
    (local.set $leaf (call $blob (i32.const 0) (i32.const 64)))
    (local.set $alias (call $ref (local.get $leaf)))
    (table.set $request (i32.const 0) (local.get $leaf))
    (table.set $request (i32.const 1) (local.get $alias))
    (table.set $request (i32.const 2) (call $tree (i32.const 0) (i32.const 0)))
    (table.set $request (i32.const 3) (call $strict (call $identify (local.get $leaf))))
    (local.set $request (call $tree (i32.const 0) (i32.const 4)))
    (memory.fill $bytes (i32.const 0) (i32.const 9) (i32.const 128))
    (local.set $hidden_blob (call $blob (i32.const 0) (i32.const 128)))
    (table.set $hidden (i32.const 0) (local.get $hidden_blob))
    (table.set $hidden (i32.const 1) (local.get $request))
    (local.set $hidden_tree (call $tree (i32.const 1) (i32.const 2)))
    (drop (call $blob (i32.const 0) (i32.const 256)))
    (drop (call $effect (local.get $request)))
    (drop (call $effect (local.get $alias)))
    (table.set $output (i32.const 0) (local.get $hidden_tree))
    (table.set $output (i32.const 1) (local.get $hidden_blob))
    (table.set $output (i32.const 2) (local.get $request))
    (call $tree (i32.const 2) (i32.const 3))))
