(module
  (import "fix" "get_type" (func $get_type (param externref) (result i32)))
  (import "fix" "get_tree_element" (func $get (param externref i32) (result externref)))
  (import "fix" "effect" (func $effect (param externref) (result externref)))
  (import "fix" "is_comparable" (func $comparable (param externref) (result i32)))
  (import "fix" "create_strict_encode" (func $strict (param externref) (result externref)))
  (import "fix" "create_shallow_encode" (func $shallow (param externref) (result externref)))
  (import "fix" "get_encode_type" (func $encode_type (param externref) (result i32)))
  (import "fix" "create_tree" (func $tree (param i32 i32) (result externref)))
  (table $saved 3 externref)
  (func (export "_fix_apply") (param $combination externref) (result externref)
    (local $argument externref)
    (local.set $argument (call $get (local.get $combination) (i32.const 2)))
    (if (i32.eq (call $get_type (local.get $argument)) (i32.const 2))
      (then
        (if (call $comparable (local.get $argument)) (then unreachable))
        (table.set $saved (i32.const 0) (local.get $argument))
        (table.set $saved (i32.const 1) (call $strict (local.get $argument)))
        (table.set $saved (i32.const 2) (call $shallow (local.get $argument)))
        (if (call $encode_type (table.get $saved (i32.const 1))) (then unreachable))
        (if (i32.ne (call $encode_type (table.get $saved (i32.const 2))) (i32.const 1)) (then unreachable))
        (drop (call $tree (i32.const 0) (i32.const 3)))
        (drop (call $effect (call $get (local.get $combination) (i32.const 3))))
        (return (table.get $saved (i32.const 0)))))
    (local.get $argument)))
