(module
  (import "fix" "get_tree_element" (func $get (param i32 i32) (result i32)))
  (import "fix" "eval" (func $eval (param i32) (result i32)))
  (import "fix" "attach_blob" (func $attach (param i32 i32) (result i32)))
  (import "fix" "create_blob_i64" (func $blob (param i64) (result i32)))
  (import "fix" "create_identification_thunk" (func $identify (param i32) (result i32)))
  (import "fix" "create_strict_encode" (func $strict (param i32) (result i32)))
  (memory $value 0)
  (func
    (export "_fix_apply")
    (param $combination i32)
    (result i32)
    (local $argument i32)
    (local.set $argument (call $get (local.get $combination) (i32.const 2)))
    (drop (call $attach (i32.const 0) (call $get (local.get $combination) (i32.const 3))))
    (if
      (i32.wrap_i64 (i64.load $value (i32.const 0)))
      (then (local.set $argument (call $strict (call $identify (local.get $argument))))))
    (drop (call $attach (i32.const 0) (call $eval (local.get $argument))))
    (call $blob (i64.add (i64.load $value (i32.const 0)) (i64.const 1)))))
