(module
  (import "fix" "get_tree_element" (func $get (param externref i32) (result externref)))
  (import "fix" "eval" (func $eval (param externref) (result externref)))
  (import "fix" "attach_blob" (func $attach (param externref i32)))
  (import "fix" "create_blob_i64" (func $blob (param i64) (result externref)))
  (import "fix" "create_identification_thunk" (func $identify (param externref) (result externref)))
  (import "fix" "create_strict_encode" (func $strict (param externref) (result externref)))
  (memory $value 0)
  (func (export "_fix_apply") (param $combination externref) (result externref)
    (local $argument externref)
    (local.set $argument (call $get (local.get $combination) (i32.const 2)))
    (call $attach (call $get (local.get $combination) (i32.const 3)) (i32.const 0))
    (if (i32.wrap_i64 (i64.load $value (i32.const 0)))
      (then (local.set $argument (call $strict (call $identify (local.get $argument))))))
    (call $attach (call $eval (local.get $argument)) (i32.const 0))
    (call $blob (i64.add (i64.load $value (i32.const 0)) (i64.const 1)))))
