-- adapted from fix/src/test/test-bptree-get.cc
get_n = @"bptree_get_n.elf"
right = (0x0105000000060000000700000008000000 "5" "6" "7" "8" ())
left = (0x0101000000020000000300000004000000 "1" "2" "3" "4" right)
root = (0x0005000000 left right)
results = *#(get_n *[root 0u8] root 3u32 2u64)
*[*[results 1u8] 0u8]
