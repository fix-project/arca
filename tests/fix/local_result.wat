(module
  (import "fix" "create_blob_i64" (func $integer (param i64) (result externref)))
  (import "fix" "create_tree" (func $tree (param i32 i32) (result externref)))
  (table $scratch 2 externref)
  (func (export "_fix_apply") (param externref) (result externref)
    (local $inner externref)
    (table.set $scratch (i32.const 0) (call $integer (i64.const 42)))
    (table.set $scratch (i32.const 1) (table.get $scratch (i32.const 0)))
    (local.set $inner (call $tree (i32.const 0) (i32.const 2)))
    (table.set $scratch (i32.const 0) (local.get $inner))
    (table.set $scratch (i32.const 1) (call $integer (i64.const 7)))
    (call $tree (i32.const 0) (i32.const 2))))
