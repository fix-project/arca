load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load("//programs/arca:defs.bzl", "ARCA_COMBINATORS", "ARCA_PROGRAMS")
load("//programs/kernel:defs.bzl", "KERNEL_PROGRAMS")
load("//programs/fix:defs.bzl", "FIX_RUST_PROGRAMS")

HOST = [
    "//fix/api",
    "//fix/storage",
    "//fix/repository",
    "//arca/kernel:tests",
    "//fix/runtime:tests",
    "//tests/kernel:harness_test",
    "//tests/kernel:harness_probe",
    "//tools/vmm:vmm",
    "//tools:bindgen",
    "//tools:postprocess",
    "//tools/module-combiner:wasm_merge",
    "//fix/cli:fix",
    "//build:fix_test",
    "//programs/fix:addblob",
    "//programs/flatware:ls_wasm",
    "//fix/handle",
]

GUEST = [
    "//fix/runtime:image_elf",
    "//arca/kernel:test_image",
    "//fix/runtime:test_image",
    "//tests/arca:simd_elf",
    "//tests/arca:continuations_elf",
    "//tests/kernel:threads_image",
    "//tests/kernel:harness_image",
] + ["//programs/kernel:" + name + "_image" for name in KERNEL_PROGRAMS] + [
    "//programs/arca:" + name + "_elf" for name in ARCA_PROGRAMS + ARCA_COMBINATORS + ["webserver", "webserver2"]
] + [
    "//programs/arca:" + name + "_image" for name in ARCA_PROGRAMS
]

CHECKS = HOST + GUEST + ["//bootstrap:seed_tool", "//flatware:tree", "//fix/preprocessor", "//programs/fix/parser:wasm", "//tests/flatware:runner_probe_wasm"] + [
    "//programs/fix:" + name + "_wasm" for name in FIX_RUST_PROGRAMS
]

rustfmt_test(
    name = "rust_format",
    tags = ["manual"],
    targets = CHECKS,
    transitive = True,
)

rust_clippy_test(
    name = "rust_lint",
    tags = ["manual"],
    targets = CHECKS,
    transitive = True,
)

test_suite(name = "format", tags = ["manual"], tests = [":rust_format", "//fix/sdk:format_test"])
test_suite(name = "lint", tags = ["manual"], tests = [":rust_lint", "//fix/sdk:lint"])


sh_test(
    name = "compile_test",
    srcs = ["compile_test.sh"],
    args = ["$(rootpath //fix/cli:fix)", "$(rootpath //programs/fix:fib_module)", "$(rootpath //programs/fix:addblob_module)", "$(rootpath //fix/cli:precompiled)"],
    data = ["//fix/cli:fix", "//programs/fix:fib_module", "//programs/fix:addblob_module", "//fix/cli:precompiled"],
    size = "large",
    timeout = "moderate",
    tags = ["kvm", "local", "manual"],
)
