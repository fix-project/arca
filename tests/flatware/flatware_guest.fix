program = $flatware_guest_native
stat = (0u64 3u8 1u64 0u64 100u64 100u64 100u64)
seed = 0u64
result = *#("" program ("fixture" "foo") ("HELLO=world") (("stdin" () "input") ("stdout" () "prefix:") ("stderr" () "") ("/work" stat ())) seed 100u64)
descriptors = *[result 0u64]
directory = *[descriptors 3u64]
entries = *[directory 2u64]
file = *[entries 1u64]
stdout = *[descriptors 1u64]
checker = $check_result_native
*#("" checker (*[stdout 2u64] *[result 1u64] *[file 2u64]) ("prefix:flatware-ok" 7u32 "hello world"))
