load("//build:cc.bzl", "cc_object")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//build:defs.bzl", "fix_script_test", "wat_module")
load("//flatware:defs.bzl", "flatware_procedure")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.fix"]))

cc_object(
    name = "flatware_guest_wasm_object",
    src = "flatware_guest.c",
    compiler = "@local_tools//:clang",
    copts = ["--target=wasm32", "-O2", "-ffreestanding", "-nostdlib"],
)

genrule(
    name = "flatware_guest_wasm",
    srcs = [":flatware_guest_wasm_object"],
    outs = ["flatware_guest.wasm"],
    tools = ["@local_tools//:clang"],
    cmd = "$(execpath @local_tools//:clang) --target=wasm32 -O2 -nostdlib " +
          "-Wl,--no-entry -Wl,--export-memory -Wl,--export=_start -Wl,--allow-undefined $< -o $@",
)

flatware_procedure(
    name = "flatware_guest_native",
    wasm = ":flatware_guest_wasm",
)

wat_module(name = "flatware_guest_return_wasm", src = "flatware_return.wat")

flatware_procedure(
    name = "flatware_guest_return_native",
    wasm = ":flatware_guest_return_wasm",
)

fix_script_test(
    name = "flatware_guest_test",
    size = "large",
    timeout = "short",
    script = "flatware_guest.fix",
    data = ["flatware_guest.fix", ":flatware_guest_native", "//tests/fix:check_result_native"],
    expected = "2a00000000000000",
    tags = ["kvm", "local"],
)

fix_script_test(
    name = "flatware_return_status_test",
    size = "large",
    timeout = "short",
    script = "flatware_return_status.fix",
    data = ["flatware_return_status.fix", ":flatware_guest_return_native"],
    expected = "00000000",
    tags = ["kvm", "local"],
)

test_suite(
    name = "tests",
    tests = [":flatware_guest_test", ":flatware_return_status_test", ":filesystem_test", ":runner_test"],
)

cc_test(
    name = "filesystem_test",
    srcs = ["filesystem_test.c", "//flatware:c/wasi.c", "//flatware:c/filesystem.c", "//flatware:c/bytes.c", "//flatware:c/flatware.h"],
    deps = ["//third_party/mt19937"],
    copts = ["-std=c17", "-ffreestanding", "-fno-builtin", "-Wno-attributes", "-Ifix/sdk/include", "-Iflatware/c"],
    additional_compiler_inputs = ["//fix/sdk:headers"],
)

rust_binary(
    name = "runner_probe_wasm",
    srcs = ["runner_probe.rs"],
    edition = "2024",
    platform = "//build/platforms:wasip1",
    rustc_flags = ["-Copt-level=2"],
)

flatware_procedure(name = "runner_probe_native", wasm = ":runner_probe_wasm")

sh_test(
    name = "runner_test",
    srcs = ["runner_test.sh"],
    args = ["$(rootpath " + target + ")" for target in [
        "//fix",
        ":runner_probe_native",
        "//programs/fix/json:json_elf",
        "//flatware:cpio_elf",
        "//flatware:normalize_elf",
        "//programs/fix:compose_elf",
    ]],
    data = [":runner_probe_native", "//fix", "//programs/fix/json:json_elf", "//flatware:cpio_elf", "//flatware:normalize_elf", "//programs/fix:compose_elf"],
    size = "large",
    timeout = "moderate",
    tags = ["kvm", "local"],
)

sh_test(
    name = "compile_test",
    srcs = ["compile_test.sh"],
    args = ["$(rootpath //fix)", "$(rootpath :flatware_guest_return_wasm)", "$(rootpath //bootstrap:repository_archive)"],
    data = ["//fix", ":flatware_guest_return_wasm", "//bootstrap:repository_archive"],
    size = "large",
    timeout = "long",
    tags = ["kvm", "local", "manual"],
)
