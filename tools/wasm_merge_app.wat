(module
  (type $answer (func (result i32)))
  (import "lib" "answer" (func $answer (type $answer)))
  (import "lib" "first_byte" (func $first_byte (result i32)))
  (import "lib" "counter" (global $counter (mut i32)))
  (import "lib" "functions" (table 1 funcref))
  (import "lib" "exception" (tag $exception (param i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "random_get" (func $random (param i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data $output "OK")
  (func (export "one") (result i32) (i32.const 1))
  (func $initialize
    (if (i32.ne (global.get $counter) (i32.const 41)) (then unreachable)))
  (start $initialize)
  (func (export "_start")
    (if (call $random (i32.const 64) (i32.const 1)) (then unreachable))
    (if (i32.ne (call $answer) (i32.const 42)) (then unreachable))
    (if (i32.ne (call_indirect (type $answer) (i32.const 0)) (i32.const 42)) (then unreachable))
    (if (i32.ne (call $first_byte) (i32.const 80)) (then unreachable))
    (block $caught (result i32)
      (try_table (catch $exception $caught) (throw $exception (i32.const 7)))
      unreachable)
    drop
    (memory.init $output (i32.const 32) (i32.const 0) (i32.const 2))
    (i32.store (i32.const 0) (i32.const 32))
    (i32.store (i32.const 4) (i32.const 2))
    (drop (call $write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))))
