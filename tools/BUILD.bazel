load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//build:defs.bzl", "FIX_COPTS", "wat_module")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["lsp.sh", "format.sh", "cc_format.sh", "cc_lint.sh"])

rust_binary(
    name = "bindgen",
    srcs = ["bindgen.rs"],
    edition = "2024",
    deps = ["@crates//:bindgen"],
)

rust_binary(
    name = "postprocess",
    srcs = [
        "postprocess.rs",
        "postprocessor.rs",
        "postprocessor_tests.rs",
    ],
    crate_root = "postprocess.rs",
    edition = "2024",
    deps = [
        "@crates//:anyhow",
        "@crates//:wasm-encoder",
        "@crates//:wasmparser",
    ],
)

wat_module(name = "postprocessor_fixture", src = "postprocessor_fixture.wat", debug_names = True)
wat_module(name = "postprocessor_import_only", src = "postprocessor_import_only.wat")

rust_test(
    name = "postprocess_test",
    srcs = ["postprocessor.rs", "postprocessor_tests.rs"],
    crate_root = "postprocessor.rs",
    edition = "2024",
    deps = ["@crates//:anyhow", "@crates//:wasm-encoder", "@crates//:wasmparser"],
    compile_data = [":postprocessor_fixture", ":postprocessor_import_only"],
    rustc_env = {
        "POSTPROCESSOR_FIXTURE": "$(execpath :postprocessor_fixture)",
        "POSTPROCESSOR_IMPORT_ONLY": "$(execpath :postprocessor_import_only)",
    },
    timeout = "short",
)

sh_binary(name = "compile", srcs = ["compile.sh"])
genrule(
    name = "fix_copts",
    outs = ["fix_copts.txt"],
    cmd = "printf '%s\\n' " + " ".join(FIX_COPTS) + " > $@",
)

alias(name = "wasm_merge", actual = "//tools/module-combiner:wasm_merge", tags = ["manual"])

alias(name = "wasm_merge_wasm", actual = "//tools/module-combiner:wasm_merge_wasm", tags = ["manual"])

wat_module(name = "wasm_merge_library", src = "wasm_merge_library.wat")
wat_module(name = "wasm_merge_app", src = "wasm_merge_app.wat")

sh_test(
    name = "wasm_merge_test",
    srcs = ["wasm_merge_test.sh"],
    args = ["$(rootpath " + target + ")" for target in [
        ":wasm_merge", ":wasm_merge_wasm", "//flatware:run", ":wasm_merge_library", ":wasm_merge_app",
    ]],
    data = [":wasm_merge", ":wasm_merge_wasm", "//flatware:run", ":wasm_merge_library", ":wasm_merge_app"],
    tags = ["kvm", "local", "manual"],
    size = "large",
    timeout = "long",
)
