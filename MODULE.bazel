module(
    name = "fix",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.74.0")
# Fix custom target paths, identities, and build-script feature probes.
single_version_override(
    module_name = "rules_rust",
    patches = ["//build:rules_rust.patch"],
    patch_strip = 1,
)
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")

foreign_tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools")
foreign_tools.explicit()
foreign_tools.cmake(mode = "system")
foreign_tools.make(mode = "system")
foreign_tools.ninja(mode = "noop")
foreign_tools.m4(mode = "noop")
foreign_tools.pkgconfig(mode = "noop")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_rustc_flags_triples = {
        "x86_64-unknown-linux-gnu": ["-Cforce-frame-pointers=on"],
        "x86_64-unknown-none": [
            "-Cforce-frame-pointers=on",
            "-Ccode-model=large",
            "-Crelocation-model=static",
        ],
        "wasm32-unknown-unknown": ["-Ccodegen-units=1"],
    },
    extra_target_triples = [
        "x86_64-unknown-none",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
    ],
    rustfmt_version = "nightly/2026-09-28",
    versions = ["nightly/2026-09-28"],
)
use_repo(
    rust,
    "rust_toolchains",
    host_rust_tools = "rust_linux_x86_64__x86_64-unknown-linux-gnu__nightly_tools",
    arca_rust_tools = "rust_linux_x86_64__x86_64-unknown-none__nightly_tools",
)

register_toolchains("//build/platforms:arca_rust", "//build/platforms:arca_user_rust", "@rust_toolchains//:all")

cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure, "local_config_cc")

register_toolchains("//build/platforms:arca_cc")

register_execution_platforms("//build/platforms:host")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.annotation(
    crate = "blake3",
    version = "1.8.7",
    patches = ["//build:blake3-custom-target.patch"],
    patch_args = ["-p1"],
)
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//third_party/rust:Cargo.lock",
    manifests = ["//third_party/rust:Cargo.toml"],
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-none",
        "wasm32-unknown-unknown",
        "wasm32-wasip1",
    ],
)
use_repo(crate, "crates")

local_tools = use_repo_rule("//build:repositories.bzl", "local_tools")

local_tools(name = "local_tools")

new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "wabt_src",
    build_file = "//build:wabt.BUILD.bazel",
    path = "third_party/wabt",
)

new_local_repository(
    name = "coupon_proof",
    build_file = "//build:proof.BUILD.bazel",
    path = "coupon/proof",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "rust_src",
    urls = ["https://static.rust-lang.org/dist/2026-09-28/rust-src-nightly.tar.xz"],
    sha256 = "681da083978612ab5062d6e656143055fb4b27b0a3b7ab85bb62a1598be43677",
    strip_prefix = "rust-src-nightly/rust-src/lib/rustlib/src/rust/library",
    build_file_content = 'filegroup(name = "sources", srcs = glob(["**"]), visibility = ["//visibility:public"])\nexports_files(["core/src/lib.rs"])',
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "dlmalloc_src",
    urls = ["https://gee.cs.oswego.edu/pub/misc/malloc.c"],
    sha256 = "be7be56b40b4b31417e74e77687f9b96127ea6cae534cf236aee40a4c739508d",
    downloaded_file_path = "malloc.c",
)

http_file(
    name = "mt19937_src",
    urls = ["https://www.math.sci.hiroshima-u.ac.jp/m-mat/MT/VERSIONS/C-LANG/mt19937-64.c"],
    sha256 = "7a42a33ed3327c5dc2785afa5d3508ebb67343ba2c360767a8f5799e6c3d0cfe",
    downloaded_file_path = "mt19937-64.c",
)

bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    patches = ["//build:hedron-bazel9.patch"],
    patch_strip = 1,
)

http_archive(
    name = "llvm-raw",
    urls = ["https://github.com/fix-project/llvm-project/archive/3c24197a97c8f1200596d2dc3dd4335960a3bbc6.tar.gz"],
    sha256 = "52f4e5b06eaecc30140ed60e88e97a01bc1d2706ce71c22ea83f872f761001bc",
    strip_prefix = "llvm-project-3c24197a97c8f1200596d2dc3dd4335960a3bbc6",
    build_file = "//bootstrap:llvm.BUILD.bazel",
    patches = ["//bootstrap:toolchain-tags.patch"],
    patch_args = ["-p1"],
)

bazel_dep(name = "llvm", version = "0.8.5")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "zlib-ng", version = "2.3.3", repo_name = "llvm_zlib")
bazel_dep(name = "zstd", version = "1.5.7.bcr.1", repo_name = "llvm_zstd")
bazel_dep(name = "libpfm", version = "4.13.0", repo_name = "pfm")

llvm_configure = use_repo_rule("@llvm-raw//utils/bazel:configure.bzl", "llvm_configure")
llvm_configure(name = "llvm-project", targets = ["X86", "WebAssembly"])
