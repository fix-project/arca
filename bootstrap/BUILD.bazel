load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_lib//lib:directory_path.bzl", "directory_path")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":cmake.bzl", "MAPS", "source_build")
load(":defs.bzl", "promote_seed", "seed_repository")
load(":files.bzl", "archive_directory", "wasm_tools", "toolchain_files", "mapped_directory")
load(":native.bzl", "UNITS", native_generation = "generation", native_program = "program")
load(":configuration.bzl", "stage")
load(":tools.bzl", "COMMANDS")
load("//build:fix.bzl", "fix_run")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

exports_files(["llvm_release.BUILD.bazel", "llvm_rootfs.BUILD.bazel"])

rust_binary(
    name = "seed_tool",
    srcs = ["seed.rs"],
    crate_root = "seed.rs",
    edition = "2024",
    deps = ["//fix/handle", "//fix/repository", "//flatware:tree"],
)

bool_flag(name = "debug", build_setting_default = False)
config_setting(name = "debug_enabled", flag_values = {":debug": "true"})

exports_files(["defs.bzl", "files.bzl", "cmake.bzl", "native.bzl", "configuration.bzl", "tools.bzl", "README.md"])

SYSROOT = "$${EXT_BUILD_ROOT}/$(execpath :wasi_sysroot)"
WASM_FLAGS = MAPS + " -resource-dir=$${EXT_BUILD_ROOT}/$(execpath :wasi_resources)"
WASI_TARGET = {
    "CMAKE_SYSTEM_NAME": "Generic",
    "CMAKE_C_COMPILER_TARGET": "wasm32-unknown-wasip1",
    "CMAKE_CXX_COMPILER_TARGET": "wasm32-unknown-wasip1",
    "CMAKE_ASM_COMPILER_TARGET": "wasm32-unknown-wasip1",
}
WASI_TOOLS = {
    "CMAKE_C_COMPILER": "@llvm_sdk//:bin/clang",
    "CMAKE_CXX_COMPILER": "@llvm_sdk//:bin/clang++",
    "CMAKE_ASM_COMPILER": "@llvm_sdk//:bin/clang",
    "CMAKE_AR": "@llvm_sdk//:bin/llvm-ar",
    "CMAKE_RANLIB": "@llvm_sdk//:bin/llvm-ranlib",
}

copy_to_directory(
    name = "wabt_sources",
    srcs = ["@wabt_src//:sources"],
    include_external_repositories = ["**"],
    tags = ["manual"],
)

archive_directory(name = "wasi_resources", src = "@llvm_sdk//:resources", strip_prefix = "lib/clang/23/", tags = ["manual"])
archive_directory(name = "wasi_sysroot", src = "@llvm_sdk//:sysroot", strip_prefix = "share/wasi-sysroot/", tags = ["manual"])
archive_directory(name = "release_rootfs", src = "@llvm_rootfs//:files", tags = ["manual"])

source_build(
    name = "host_wasm2c",
    lib_source = ":wabt_sources",
    working_directory = "wabt_sources",
    copies = {
        "wasm2c": "bin/wasm2c",
    },
    options = {
        "BUILD_TESTS": "OFF",
        "BUILD_LIBWASM": "OFF",
        "BUILD_TOOLS": "ON",
    },
    targets = ["wasm2c"],
    tags = ["manual"],
)

source_build(
    name = "wasm2c",
    data = ["@llvm_sdk//:bin/wasm-ld"],
    resources = ":wasi_resources",
    tools = WASI_TOOLS,
    lib_source = ":wabt_sources",
    working_directory = "wabt_sources",
    sysroot = ":wasi_sysroot",
    copies = {
        "wasm2c": "wasm2c.wasm",
    },
    options = WASI_TARGET | {
        "CMAKE_SYSROOT": SYSROOT,
        "CMAKE_C_FLAGS": WASM_FLAGS,
        "CMAKE_CXX_FLAGS": WASM_FLAGS + " -fwasm-exceptions",
        "CMAKE_CXX_STANDARD_LIBRARIES": "-lunwind",
        "BUILD_TESTS": "OFF",
        "BUILD_LIBWASM": "OFF",
        "BUILD_TOOLS": "ON",
        "CMAKE_EXE_LINKER_FLAGS": "--no-wasm-opt -fuse-ld=$${EXT_BUILD_ROOT}/$(execpath @llvm_sdk//:bin/wasm-ld) -Wl,-z,stack-size=16777216",
        "WITH_WASI": "OFF",
        "WITH_EXCEPTIONS": "OFF",
    },
    targets = ["wasm2c"],
    tags = ["manual"],
)

wasm_tools(name = "stage0", tags = ["manual"])
native_generation("stage1")
native_program(name = "compile", src = "//programs/fix:compile_module", directory = "compile")
native_program(name = "scheduler", src = "//programs/fix:scheduler_module", directory = "scheduler")
native_program(name = "collector", src = "//fix/proof/collector:module", directory = "collector")

copy_to_directory(
    name = "simde_headers",
    srcs = ["@wabt_src//:simde_headers"],
    include_external_repositories = ["**"],
    root_paths = ["third_party/simde"],
    tags = ["manual"],
)

directory_path(
    name = "simde_include",
    directory = ":simde_headers",
    path = "simde",
    tags = ["manual"],
)

toolchain_files(
    name = "toolchain_files",
    stage0 = ":stage0",
    resources = {
        ":simde_include": "usr/include/simde",
        "//fix/shell:shell": "share/fix/libfixshell.a",
        "//fix/shell:wasm_rt": "share/fix/wasm-rt.c",
        "//fix/shell:memmap": "share/fix/memmap.ld",
        "//fix/shell:headers": "share/fix/",
    },
    tags = ["manual"],
)

directory_path(name = "release_rootfs_usr", directory = ":release_rootfs", path = "usr", tags = ["manual"])
mapped_directory(name = "wasip1_sysroot", srcs = {":release_rootfs_usr": "."}, tags = ["manual"])

seed_repository(
    name = "seed",
    compiler = ":compile_link",
    wasm2c = ":stage1_wasm2c_link",
    clang = ":stage1_clang_link",
    toolchain = ":toolchain_files",
    programs = {
        ":scheduler_link": "scheduler",
        ":collector_link": "collector",
        "//programs/fix/parser:parser_elf": "fix-parser",
    },
    tags = ["manual"],
)

alias(name = "bootstrap", actual = ":seed", tags = ["manual"])

stage(name = "compile_module", srcs = ["//programs/fix:compile_module"], tags = ["manual"])

COMPILER_REBUILD = '(("compile" ("" *#(536870912u64 $compile @file("compile.wasm") %du64) *[$compile 2u64])))' % UNITS

# Rebuilds the compiler inside Fix; the archive carries its compile coupon.
fix_run(
    name = "compilations",
    jobs = 1,
    memory = 65536,
    expression = COMPILER_REBUILD,
    bindings = {"compile": '@label("compile")'},
    data = {":compile_module": "compile.wasm"},
    archives = [":seed"],
    fix = ":release_fix",
    tags = ["manual"],
)

stage(name = "release_fix", srcs = ["//fix/cli:fix"], tags = ["manual"])

promote_seed(name = "promoted_seed", seed = ":seed", compilation = ":compilations", fix = ":release_fix", tags = ["manual"])

fix_run(
    name = "stabilized_compilations",
    jobs = 1,
    memory = 65536,
    expression = COMPILER_REBUILD,
    bindings = {"compile": '@label("compile")'},
    data = {":compile_module": "compile.wasm"},
    archives = [":promoted_seed"],
    fix = ":release_fix",
    tags = ["manual"],
)

promote_seed(name = "stabilized_seed", seed = ":promoted_seed", compilation = ":stabilized_compilations", fix = ":release_fix", tags = ["manual"])

fix_run(
    name = "checked_compilations",
    jobs = 1,
    memory = 65536,
    expression = COMPILER_REBUILD,
    bindings = {"compile": '@label("compile")'},
    data = {":compile_module": "compile.wasm"},
    archives = [":stabilized_seed"],
    fix = ":release_fix",
    tags = ["manual"],
)

filegroup(name = "stabilized_handle", srcs = [":stabilized_compilations"], output_group = "handle", tags = ["manual"])
filegroup(name = "checked_handle", srcs = [":checked_compilations"], output_group = "handle", tags = ["manual"])

sh_test(
    name = "stability",
    srcs = ["stability_test.sh"],
    args = ["$(rootpath :stabilized_handle)", "$(rootpath :checked_handle)"],
    data = [":stabilized_handle", ":checked_handle"],
    tags = ["manual", "kvm", "local"],
)
