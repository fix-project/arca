load("//build:rocq.bzl", "rocq_library")
load("//build:proof_modules.bzl", "MODULES")

package(default_visibility = ["//visibility:public"])

exports_files(["coupon.wat"])

[
    rocq_library(
        name = name,
        src = "wasm-proofs/rocq/" + name + ".v",
        deps = [":" + dep for dep in deps],
        data = [":check_generated"] if name == "Init" else [],
        namespace = "FixProof",
        tags = ["manual"],
    )
    for name, deps in MODULES.items()
]

genrule(
    name = "check_generated",
    srcs = [
        "coupon.wat",
        "scripts/generate-rocq-init.py",
        "wasm-proofs/rocq/Init.v",
    ],
    outs = ["generated.checked"],
    tools = ["@rocq_host//:wat2wasm"],
    cmd = "PATH=$$(dirname $(execpath @rocq_host//:wat2wasm)):$$PATH python3 $(location scripts/generate-rocq-init.py) --check && touch $@",
    tags = ["manual"],
)
