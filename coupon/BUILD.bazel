load("@rules_rust//rust:defs.bzl", "rust_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//build:defs.bzl", "fix_procedure", "wat_module")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "api",
    visibility = ["//visibility:public"],
    srcs = ["api.rs"],
    edition = "2024",
)

genrule(
    name = "adapt",
    srcs = [
        "@coupon_proof//:coupon.wat",
        "prologue.wat",
        "epilogue.wat",
        "rewrite-wat.sh",
    ],
    outs = ["coupon-collector.wat"],
    cmd = "$(execpath @local_tools//:bash) $(location rewrite-wat.sh) $(location @coupon_proof//:coupon.wat) $(location prologue.wat) $(location epilogue.wat) $@",
    tools = ["@local_tools//:bash"],
)

wat_module(
    name = "wasm",
    src = ":adapt",
    out = "coupon-collector.wasm",
)

fix_procedure(
    name = "collector",
    visibility = ["//visibility:public"],
    wasm = ":wasm",
    runnable = True,
)

sh_test(
    name = "proof",
    size = "enormous",
    srcs = ["proof_test.sh"],
    args = ["$(rlocationpath @coupon_proof//:coupon.wat)"],
    data = [
        "@bazel_tools//tools/bash/runfiles",
        "@coupon_proof//:coupon.wat",
        "@coupon_proof//:sources",
    ],
    tags = [
        "local",
        "manual",
        "proof",
    ],
)
