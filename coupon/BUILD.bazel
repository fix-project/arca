load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build:rocq.bzl", "rocq_test")
load("//build:proof_modules.bzl", "MODULES")
load("//build:defs.bzl", "fix_procedure", "wat_module")

package(default_visibility = ["//visibility:private"])

rust_library(
    name = "api",
    visibility = ["//visibility:public"],
    srcs = ["api.rs"],
    edition = "2024",
)

genrule(
    name = "adapt",
    tags = ["manual"],
    srcs = [
        "//coupon/proof:coupon.wat",
        "prologue.wat",
        "epilogue.wat",
        "rewrite-wat.sh",
    ],
    outs = ["coupon-collector.wat"],
    cmd = "$(execpath @local_tools//:bash) $(location rewrite-wat.sh) $(location //coupon/proof:coupon.wat) $(location prologue.wat) $(location epilogue.wat) $@",
    tools = ["@local_tools//:bash"],
)

wat_module(
    name = "wasm",
    tags = ["manual"],
    src = ":adapt",
    out = "coupon-collector.wasm",
)

fix_procedure(
    name = "collector",
    tags = ["manual"],
    visibility = ["//visibility:public"],
    wasm = ":wasm",
    runnable = True,
)

filegroup(
    name = "proof_modules",
    srcs = ["//coupon/proof:" + name for name in MODULES],
    tags = ["manual"],
)

[
    rocq_test(
        name = "proof_" + name,
        size = "enormous",
        deps = ["//coupon/proof:" + name],
        tags = ["local", "manual", "proof"],
    )
    for name in MODULES
]

rocq_test(
    name = "proof_dependencies",
    size = "enormous",
    modules = "@rocq_host//:dependencies",
    tags = ["local", "manual", "proof"],
)

test_suite(
    name = "proof",
    tests = [":proof_" + name for name in MODULES] + [":proof_dependencies"],
    tags = ["manual", "proof"],
)
