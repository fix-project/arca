load(":defs.bzl", "FIX_PROGRAMS", "fix_rust_program", "fix_wat_program")
load("//build:defs.bzl", "fix_script_test")

package(default_visibility = ["//visibility:private"])

exports_files(glob(["fixtures/*.fix"]))

[fix_wat_program(name = name) for name in FIX_PROGRAMS]
alias(name = "addblob_module", actual = ":addblob_wasm", visibility = ["//tests:__pkg__"])
fix_rust_program(name = "map")
fix_rust_program(name = "compose", artifact_visibility = ["//visibility:public"])
fix_rust_program(name = "compile", alloc = True, artifact_visibility = ["//visibility:public"])
alias(name = "compile_module", actual = ":compile_postprocess", visibility = ["//bootstrap:__pkg__"])
fix_rust_program(name = "mapreduce")
fix_rust_program(name = "fib")
alias(name = "fib_module", actual = ":fib_postprocess", visibility = ["//tests:__pkg__"])
fix_rust_program(name = "count_words", alloc = True)
fix_rust_program(name = "bptree_get", alloc = True)
fix_rust_program(name = "bptree_get_n", alloc = True)

fix_script_test(
    name = "tests",
    visibility = ["//:__pkg__"],
    script = "programs.fix",
    data = ["fixtures/programs.fix", ":addblob_elf", "//tests/fix:check_result_native"],
    expected = "2a00000000000000",
    size = "large",
    timeout = "short",
    tags = ["kvm", "local"],
)

fix_script_test(
    name = "run_test",
    script = "c.fix",
    data = ["fixtures/c.fix", "//programs/fix/c:blob_elf", "//programs/fix/c:add_elf", "//tests/fix:check_result_native"],
    expected = "2a00000000000000",
    size = "large",
    timeout = "short",
    tags = ["kvm", "local"],
)
