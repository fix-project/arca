load("@rules_rust//rust:defs.bzl", "rust_test")
load(":defs.bzl", "FIX_PROGRAMS", "fix_rust_program", "fix_wat_program")
load("//build:defs.bzl", "fix_script_test")

package(default_visibility = ["//visibility:private"])

exports_files(glob(["fixtures/*.fix"]))

[fix_wat_program(name = name) for name in FIX_PROGRAMS]
alias(name = "addblob_module", actual = ":addblob_wasm", visibility = ["//tests:__pkg__", "//tests/fix:__pkg__"])
fix_rust_program(name = "scheduler", src = "//fix/scheduler:examples/parallel.rs", srcs = ["//fix/scheduler:parallel_sources"], importers = True, memories = 4, artifact_visibility = ["//visibility:public"], deps = ["//fix/scheduler:sdk"])
fix_rust_program(name = "map", alloc = True)
fix_rust_program(name = "compile", alloc = True, artifact_visibility = ["//visibility:public"])
alias(name = "compile_module", actual = ":compile_postprocess", visibility = ["//bootstrap:__pkg__"])
alias(name = "scheduler_module", actual = ":scheduler_postprocess", visibility = ["//bootstrap:__pkg__"])
fix_rust_program(name = "mapreduce")
fix_rust_program(name = "fib")
alias(name = "fib_module", actual = ":fib_postprocess", visibility = ["//tests:__pkg__"])
fix_rust_program(name = "count_words", alloc = True)
fix_rust_program(name = "bptree_get", alloc = True)
fix_rust_program(name = "bptree_get_n", alloc = True)

fix_script_test(
    name = "tests",
    visibility = ["//:__pkg__"],
    script = "programs.fix",
    data = ["fixtures/programs.fix", ":addblob_elf", "//tests/fix:check_result_native"],
    expected = "2a00000000000000",
    size = "large",
    timeout = "short",
    tags = ["kvm", "local"],
)

fix_script_test(
    name = "run_test",
    script = "c.fix",
    data = ["fixtures/c.fix", "//programs/fix/c:blob_elf", "//programs/fix/c:add_elf", "//tests/fix:check_result_native"],
    expected = "2a00000000000000",
    size = "large",
    timeout = "short",
    tags = ["kvm", "local"],
)

rust_test(
    name = "launchers_test",
    srcs = ["launchers_test.rs"],
    edition = "2024",
    deps = ["//fix/handle"],
    data = [
        ":fib",
        ":addblob",
        "//programs/fix/wat:blob",
        "//programs/fix/wat:add",
        "//programs/fix/wat:add_wasm",
        "//programs/fix/c:blob",
        "//programs/fix/c:add",
        "//programs/fix/rust:blob",
        "//programs/fix/rust:add",
    ],
    rustc_env = {
        "FIB": "$(rootpath :fib)",
        "ADD_BLOB": "$(rootpath :addblob)",
        "WAT_BLOB": "$(rootpath //programs/fix/wat:blob)",
        "WAT_ADD": "$(rootpath //programs/fix/wat:add)",
        "ADD_WASM": "$(rootpath //programs/fix/wat:add_wasm)",
        "C_BLOB": "$(rootpath //programs/fix/c:blob)",
        "C_ADD": "$(rootpath //programs/fix/c:add)",
        "RUST_BLOB": "$(rootpath //programs/fix/rust:blob)",
        "RUST_ADD": "$(rootpath //programs/fix/rust:add)",
    },
    size = "large",
    tags = ["kvm", "local"],
)
