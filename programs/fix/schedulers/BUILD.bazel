load(":defs.bzl", "fix_scheduler")
load("//programs/fix:defs.bzl", "fix_rust_program")

package(default_visibility = ["//visibility:public"])

fix_rust_program(name = "recompute", importers = True, rustc_flags = ["-Clink-arg=-zstack-size=8388608"], memories = 4, src = "tests/recompute.rs", srcs = ["parallel.rs"], deps = ["//fix/scheduler:sdk"], artifact_visibility = ["//visibility:public"])
fix_scheduler(name = "serial")
fix_scheduler(name = "parallel")
[
    alias(name = name + "_module", actual = ":" + name + "_postprocess")
    for name in ["serial", "parallel", "distributed", "onepass", "hint"]
]
fix_scheduler(name = "distributed", modules = ["parallel.rs"])
fix_scheduler(name = "onepass", modules = ["parallel.rs"])
fix_scheduler(name = "hint", modules = ["parallel.rs", "onepass.rs"])


fix_rust_program(name = "advisor", src = "tests/advise.rs", artifact_visibility = ["//visibility:public"])

filegroup(
    name = "schedulers",
    srcs = [":" + name + "_elf" for name in ["serial", "parallel", "distributed", "onepass", "hint"]],
)
