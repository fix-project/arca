load("//build:defs.bzl", "kernel_program", "vm_test")
load(":defs.bzl", "KERNEL_PROGRAMS")

package(default_visibility = ["//visibility:private"])

[
    kernel_program(
        name = name,
        visibility = ["//visibility:public"],
        image_visibility = ["//:__pkg__", "//tests:__pkg__"],
        srcs = ["src/" + name + ".rs"],
        compile_data = ["//programs/arca:" + name + "_elf"] if name.startswith("webserver") else [],
        crate_name = name,
        linker_script = "//arca/kernel:etc/memmap.ld",
        proc_macro_deps = ["//tools/macros"],
        rustc_env = {"ARCA_HANDLER": "$(execpath //programs/arca:" + name + "_elf)"} if name.startswith("webserver") else {},
        deps = [
            "//arca/api",
            "//arca/kernel",
            "//lib/common",
            "@crates//:log",
            "@crates//:postcard",
        ],
    )
    for name in KERNEL_PROGRAMS
]

vm_test(
    name = "hello_test",
    visibility = ["//:__pkg__"],
    size = "large",
    timeout = "short",
    args = ["Bazel"],
    expected_output = ["hello, Bazel"],
    kernel = ":hello_image",
    tags = [
        "kvm",
        "local",
    ],
)
