load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//programs/arca:defs.bzl", "ARCA_COMBINATORS", "ARCA_PROGRAMS")
load("//programs/fix:defs.bzl", "FIX_PROGRAMS", "FIX_RUST_PROGRAMS")
load("//programs/kernel:defs.bzl", "KERNEL_PROGRAMS")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "artifacts",
    srcs = [
        "//fix/runtime:image",
        "//programs/arca:webserver",
        "//programs/arca:webserver2",
        "//programs/fix/parser:parser",
        "//tools/vmm",
    ] + ["//programs/fix/" + language + ":programs" for language in ["wat", "c", "rust"]] + ["//programs/arca:" + name for name in ARCA_PROGRAMS] + [
        "//programs/arca:" + name + "_elf" for name in ARCA_COMBINATORS
    ] + [
        "//programs/fix:" + name for name in FIX_PROGRAMS + FIX_RUST_PROGRAMS
    ] + ["//programs/kernel:" + name + "_image" for name in KERNEL_PROGRAMS],
)

test_suite(
    name = "host_tests",
    tests = [
        "//arca/api:tests",
        "//fix/handle:tests",
        "//lib/common:tests",
        "//tools/vmm:tests",
        "//tools:postprocess_test",
        "//tests/flatware:filesystem_test",
    ],
)

test_suite(
    name = "guest_tests",
    tags = ["kvm"],
    tests = [
        "//arca/kernel:tests",
        "//fix/runtime:tests",
        "//programs/kernel:hello_test",
        "//programs/fix:tests",
        "//programs/fix:run_test",
        "//programs/arca:tests",
        "//tests/kernel:tests",
        "//tests/fix:tests",
        "//tests/flatware:tests",
    ] + ["//programs/fix/" + language + ":tests" for language in ["wat", "c", "rust"]],
)

sh_binary(
    name = "format",
    srcs = ["//tools:format.sh"],
)
