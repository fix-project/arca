load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "api",
    crate_name = "fix",
    srcs = glob(["src/*.rs"], exclude = ["src/types.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [":types"],
)

rust_library(
    name = "api_alloc",
    crate_name = "fix",
    srcs = glob(["src/*.rs"], exclude = ["src/types.rs"]),
    crate_root = "src/lib.rs",
    crate_features = ["alloc"],
    edition = "2024",
    deps = [":types"],
)

exports_files(["tests/values.rs"])

rust_library(
    name = "types",
    crate_name = "fixtypes",
    srcs = ["src/types.rs"],
)
