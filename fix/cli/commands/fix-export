#!/usr/bin/env bash
set -euo pipefail
FIX=${FIX:-fix}
if [[ ${1-} == --help || ${1-} == -h ]]; then
    echo 'fix export LABEL ARCHIVE.tar[.gz] [LABELS...]'
    exit 0
fi
[[ $# -ge 2 ]] || { echo 'fix export LABEL ARCHIVE.tar[.gz] [LABELS...]' >&2; exit 2; }
label=$1
archive=$2
shift 2
[[ ! -e $archive && ! -L $archive ]] || { echo "destination already exists: $archive" >&2; exit 2; }
repository=$("$FIX" repository)
for name in "$label" "$@"; do
    [[ -n $name && $name != . && $name != .. && $name != */* ]] || exit 2
done
{
    printf '.fix/data\0.fix/objects\0.fix/labels\0'
    for name in "$label" "$@"; do
        printf '.fix/labels/%s\0' "$name"
        "$FIX" visit "$name" | while read -r object; do
            printf '.fix/objects/%s\0.fix/data/%sffff\0' "$object" "${object:0:60}"
        done
    done
} | sort -zu | tar --directory "${repository%/*}" --create --auto-compress --file "$archive" --no-recursion \
    --mtime=@0 --owner=0 --group=0 --numeric-owner --null --files-from -
