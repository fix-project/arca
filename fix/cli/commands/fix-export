#!/usr/bin/env bash
set -euo pipefail
FIX=${FIX:-fix}
if [[ ${1-} == --help || ${1-} == -h ]]; then
    echo 'fix export VALUE ARCHIVE.tar[.gz] [VALUES...]'
    exit 0
fi
[[ $# -ge 2 ]] || { echo 'fix export VALUE ARCHIVE.tar[.gz] [VALUES...]' >&2; exit 2; }
value=$1
archive=$2
shift 2
[[ ! -e $archive && ! -L $archive ]] || { echo "destination already exists: $archive" >&2; exit 2; }
repository=$("$FIX" repository)
{
    printf '.fix/data\0.fix/objects\0.fix/labels\0'
    for name in "$value" "$@"; do
        "$FIX" visit --paths "$name"
    done
} | sort -zu | tar --directory "${repository%/*}" --create --auto-compress --file "$archive" --no-recursion \
    --mtime=@0 --owner=0 --group=0 --numeric-owner --null --files-from -
