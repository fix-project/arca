#!/usr/bin/env python3
import os
import subprocess
import sys

args = sys.argv[1:]
help_requested = args[:1] in (["-h"], ["--help"])
if help_requested or len(args) != 1:
    print("fix compile WASM_VALUE", file=sys.stdout if help_requested else sys.stderr)
    sys.exit(0 if help_requested else 2)
cli = os.environ.get("FIX", "fix")


def fix(*args):
    return subprocess.check_output([cli, *args]).decode().rstrip("\n")


metadata = fix("create-blob", "--string", "")
compiler = fix("create-tree", metadata, "fixpoint", "compile-resources")
source = fix("resolve", args[0])
if fix("get-type", source) == "thunk":
    source = fix("create-strict-encode", source)
partitions = fix("create-blob", "--u64", os.environ.get("FIX_COMPILE_PARTITIONS", "8"))
combination = fix("create-tree", metadata, compiler, source, partitions)
print(fix("create-application-thunk", combination))
