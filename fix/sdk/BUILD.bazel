load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library")
load("//build:cc.bzl", "cc_object")
load("//build:defs.bzl", "WASM", "fix_procedure", "vm_test", "wasm_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "headers",
    srcs = glob(["include/*.h"]),
)

rust_library(
    name = "types",
    srcs = ["src/types.rs"],
    crate_name = "fixtypes",
)

cc_object(
    name = "rust_c",
    src = "src/rust.c",
    hdrs = [":headers"],
    compiler = "@local_tools//:clang",
    copts = ["--target=wasm32", "-mreference-types", "-mbulk-memory", "-O2", "-ffreestanding", "-fno-builtin", "-nostdlib", "-Ifix/sdk/include", "-Wall", "-Wextra", "-Werror"],
)

wasm_library(
    name = "rust_runtime",
    srcs = [":rust_c"],
    target_compatible_with = ["@platforms//cpu:wasm32"],
)

rust_library(
    name = "sdk",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "fix",
    deps = [":types"],
    link_deps = [":rust_runtime"],
    proc_macro_deps = ["//tools/macros"],
    target_compatible_with = ["@platforms//cpu:wasm32"],
)

rust_shared_library(
    name = "rust_files_wasm",
    srcs = ["tests/rust_files.rs"],
    platform = WASM,
    edition = "2024",
    deps = [":sdk"],
)

[
    fix_procedure(
        name = name + "_native",
        wasm = ":" + name + "_wasm",
        memories = 2 if name == "rust_files" else None,
        tables = 2 if name == "rust_files" else None,
    )
    for name in ["rust_files"]
]

[
    genrule(
        name = name + "_fixture",
        srcs = [":" + name + "_native"],
        outs = [name],
        cmd = "cp $< $@",
    )
    for name in ["rust_files"]
]

[
    vm_test(
        name = name + "_test",
        size = "large",
        timeout = "short",
        args = ["eval", name + ".fix"],
        data = [":" + name + "_fixture", "tests/" + name + ".fix"],
        expected_output = ["as a u64: 42"],
        kernel = "//fix/runtime:image_elf",
        tags = ["kvm", "local"],
    )
    for name in ["rust_files"]
]

test_suite(name = "tests", tests = [":rust_files_test"])
