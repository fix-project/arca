load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library")
load("//build:cc.bzl", "cc_object")
load("//build:cc_checks.bzl", "cc_format", "cc_lint_test")
load("//build:defs.bzl", "WASM", "fix_procedure", "fix_script_test", "wasm_library")
load(":defs.bzl", "SDK_WARNINGS", "fix_cc_wasm", "sdk_copts")

package(default_visibility = ["//visibility:public"])

exports_files(["defs.bzl"])

cc_format(
    name = "format",
    srcs = glob(["include/*.h", "src/*.c", "tests/*.c"]),
    style = ".clang-format",
)

cc_lint_test(
    name = "c_lint_test",
    srcs = glob(["src/*.c", "tests/*.c"]),
    hdrs = [":headers"],
    config = ".clang-tidy",
    copts = sdk_copts() + SDK_WARNINGS,
)

test_suite(name = "lint", tests = [":c_lint_test"])

filegroup(
    name = "headers",
    srcs = glob(["include/*.h"]),
)

rust_library(
    name = "types",
    srcs = ["src/types.rs"],
    crate_name = "fixtypes",
)

cc_object(
    name = "rust_c",
    src = "src/rust.c",
    hdrs = [":headers"],
    compiler = "@local_tools//:clang",
    copts = sdk_copts() + SDK_WARNINGS,
)

wasm_library(
    name = "rust_runtime",
    srcs = [":rust_c"],
    target_compatible_with = ["@platforms//cpu:wasm32"],
)

cc_object(
    name = "reuse_c",
    src = "tests/reuse.c",
    hdrs = [":headers"],
    compiler = "@local_tools//:clang",
    copts = sdk_copts() + SDK_WARNINGS,
)

wasm_library(name = "reuse_runtime", srcs = [":reuse_c"])

rust_shared_library(
    name = "reuse_wasm",
    srcs = ["tests/reuse.rs"],
    platform = WASM,
    deps = [":sdk"],
    link_deps = [":reuse_runtime"],
)

fix_procedure(
    name = "reuse_native",
    wasm = ":reuse_wasm",
    memories = 3,
    tables = 3,
)

rust_shared_library(
    name = "eval_wasm",
    srcs = ["tests/eval.rs"],
    platform = WASM,
    deps = [":sdk"],
)

rust_shared_library(
    name = "attachments_wasm",
    srcs = ["tests/attachments.rs"],
    platform = WASM,
    deps = [":sdk"],
)
fix_procedure(name = "attachments_native", wasm = ":attachments_wasm", memories = 5, tables = 5)

rust_shared_library(
    name = "tagger_wasm",
    srcs = ["tests/tagger.rs"],
    platform = WASM,
    deps = [":sdk"],
)

fix_procedure(
    name = "tagger_native",
    wasm = ":tagger_wasm",
    memories = 4,
    tables = 3,
)

fix_procedure(
    name = "eval_native",
    wasm = ":eval_wasm",
    memories = 3,
    tables = 3,
)

[
    rust_library(
        name = name,
        srcs = glob(["src/**/*.rs"]),
        crate_name = "fix",
        crate_features = features,
        deps = [":types", "//fix/coupon"] + (["//fix/api"] if "alloc" in features else []) + (["//fix/importers/git"] if "git" in features else []),
        link_deps = [":rust_runtime"],
        proc_macro_deps = ["//tools/macros"],
        target_compatible_with = ["@platforms//cpu:wasm32"],
    )
    for name, features in [("sdk", []), ("sdk_alloc", ["alloc"]), ("sdk_import", ["alloc", "std", "git"])]
]

fix_cc_wasm(
    name = "c_bindings_wasm",
    srcs = ["tests/bindings.c"],
    memories = 3,
    tables = 4,
    copts = SDK_WARNINGS,
)

rust_shared_library(
    name = "rust_files_wasm",
    srcs = ["tests/rust_files.rs"],
    platform = WASM,
    edition = "2024",
    deps = [":sdk"],
)

[
    fix_procedure(
        name = name + "_native",
        wasm = ":" + name + "_wasm",
        memories = 3 if name == "rust_files" else None,
        tables = 3 if name == "rust_files" else None,
    )
    for name in ["c_bindings", "rust_files"]
]

[
    fix_script_test(
        name = name + "_test",
        size = "large",
        timeout = "short",
        script = name + ".fix",
        data = [":" + name + "_native", "tests/" + name + ".fix"],
        expected = "2a00000000000000",
        tags = ["kvm", "local"],
    )
    for name in ["c_bindings", "rust_files"]
]

test_suite(name = "tests", tests = [":c_bindings_test", ":rust_files_test"])
