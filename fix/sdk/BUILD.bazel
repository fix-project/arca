load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library")
load("//build:cc.bzl", "cc_object")
load("//build:cc_checks.bzl", "cc_format", "cc_lint_test")
load("//build:defs.bzl", "WASM", "fix_procedure", "fix_script_test", "wasm_library")
load(":defs.bzl", "SDK_WARNINGS", "fix_cc_wasm", "sdk_copts")

package(default_visibility = ["//visibility:public"])

exports_files(["defs.bzl"])

cc_format(
    name = "format",
    srcs = glob(["include/*.h", "tests/*.c"]),
    style = ".clang-format",
)

cc_lint_test(
    name = "c_lint_test",
    srcs = glob(["tests/*.c"]),
    hdrs = [":headers"],
    config = ".clang-tidy",
    copts = sdk_copts() + SDK_WARNINGS,
)

test_suite(name = "lint", tests = [":c_lint_test"])

filegroup(
    name = "headers",
    srcs = glob(["include/*.h"]),
)

rust_shared_library(
    name = "panic_wasm",
    srcs = ["tests/panic.rs"],
    platform = WASM,
    deps = [":sdk"],
)

fix_procedure(name = "panic_native", wasm = ":panic_wasm", memories = 2)

rust_shared_library(
    name = "panic_std_wasm",
    srcs = ["tests/panic.rs"],
    crate_features = ["std"],
    platform = WASM,
    deps = [":sdk_std"],
)

fix_procedure(name = "panic_std_native", wasm = ":panic_std_wasm", memories = 2)

rust_shared_library(
    name = "eval_wasm",
    srcs = ["tests/eval.rs"],
    platform = WASM,
    deps = [":sdk"],
)

rust_shared_library(
    name = "attachments_wasm",
    srcs = ["tests/attachments.rs"],
    platform = WASM,
    deps = [":sdk"],
)
fix_procedure(name = "attachments_native", wasm = ":attachments_wasm", memories = 5)

rust_shared_library(
    name = "tagger_wasm",
    srcs = ["tests/tagger.rs"],
    platform = WASM,
    deps = [":sdk_alloc", "@crates//:dlmalloc"],
)

fix_procedure(
    name = "tagger_native",
    wasm = ":tagger_wasm",
    memories = 4,
)

fix_procedure(
    name = "eval_native",
    wasm = ":eval_wasm",
    memories = 3,
)

[
    rust_library(
        name = name,
        srcs = glob(["src/**/*.rs"]),
        crate_name = "fixwasm",
        crate_features = features,
        deps = ["//fix/api:types", "//fix/coupon", "//fix/api:api_alloc" if "alloc" in features else "//fix/api"] + (["//fix/importers/git"] if "git" in features else []),
        proc_macro_deps = ["//tools/macros"],
        target_compatible_with = ["@platforms//cpu:wasm32"],
    )
    for name, features in [("sdk", []), ("sdk_alloc", ["alloc"]), ("sdk_std", ["alloc", "std"]), ("sdk_import", ["alloc", "std", "git"])]
]

fix_cc_wasm(
    name = "c_bindings_wasm",
    srcs = ["tests/bindings.c"],
    memories = 3,
    copts = SDK_WARNINGS,
)

rust_shared_library(
    name = "rust_files_wasm",
    srcs = ["tests/rust_files.rs"],
    platform = WASM,
    edition = "2024",
    deps = [":sdk"],
)

[
    fix_procedure(
        name = name + "_native",
        wasm = ":" + name + "_wasm",
        memories = 3 if name == "rust_files" else None,
        tables = None,
    )
    for name in ["c_bindings", "rust_files"]
]

[
    fix_script_test(
        name = name + "_test",
        size = "large",
        timeout = "short",
        script = name + ".fix",
        data = [":" + name + "_native", "tests/" + name + ".fix"],
        expected = "2a00000000000000",
        tags = ["kvm", "local"],
    )
    for name in ["c_bindings", "rust_files"]
]

test_suite(name = "tests", tests = [":c_bindings_test", ":rust_files_test", ":interfaces_test"])

rust_shared_library(
    name = "interfaces_wasm",
    srcs = ["tests/interfaces.rs"],
    platform = WASM,
    deps = [":sdk", "//fix/api"],
)
fix_procedure(name = "interfaces_native", wasm = ":interfaces_wasm", memories = 3)
fix_script_test(
    name = "interfaces_test",
    script = "interfaces.fix",
    data = [":interfaces_native", "tests/interfaces.fix"],
    expected = "2a00000000000000",
    size = "large",
    timeout = "short",
    tags = ["kvm", "local"],
)
