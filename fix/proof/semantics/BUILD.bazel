load("//build:rocq.bzl", "rocq_module")

package(default_visibility = ["//fix/proof:__subpackages__"])

rocq_module(
    name = "ApplyTree",
    includes = [
        "internal/ApplyTree/Congruence.v",
    ],
    namespace = "FixProof.Semantics",
    deps = [
        ":Handle",
        "//fix/proof/shell:Interface",
    ],
)

rocq_module(
    name = "Evaluation",
    includes = [
        "internal/Evaluation/Values.v",
        "machinery/Evaluation/Fuel.v",
    ],
    namespace = "FixProof.Semantics",
    deps = [
        ":ApplyTree",
        ":Handle",
        ":Identify",
        ":Select",
    ],
)

rocq_module(
    name = "Handle",
    namespace = "FixProof.Semantics",
    deps = ["//fix/proof/storage:Interface"],
)

rocq_module(
    name = "Types",
    namespace = "FixProof.Semantics",
    deps = ["//fix/proof/support:BlobInteger"],
)

rocq_module(
    name = "Identify",
    namespace = "FixProof.Semantics",
    deps = [
        ":Handle",
    ],
)

rocq_module(
    name = "Select",
    includes = [
        "internal/Select/Congruence.v",
        "internal/Select/Indices.v",
        "internal/Select/Slices.v",
    ],
    namespace = "FixProof.Semantics",
    deps = [
        ":Handle",
    ],
)

test_suite(
    name = "check",
    tests = [
        ":ApplyTree_check",
        ":Evaluation_check",
        ":Handle_check",
        ":Types_check",
        ":Identify_check",
        ":Select_check",
    ],
    tags = ["manual", "proof"],
)
