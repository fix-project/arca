load("//build:defs.bzl", "fix_procedure", "wat_module")
load("//build:rocq.bzl", "rocq_module")

package(default_visibility = ["//fix/proof:__subpackages__"])

exports_files(["collector.wat"])

wat_module(
    name = "wasm",
    visibility = ["//fix/proof/collector/wasm:__pkg__"],
    src = "collector.wat",
    out = "coupon-collector.wasm",
    tags = ["manual"],
)

alias(name = "module", actual = ":wasm", visibility = ["//bootstrap:__pkg__"])

fix_procedure(
    name = "collector",
    wasm = ":wasm",
    runnable = True,
    visibility = ["//visibility:public"],
    artifact_visibility = ["//visibility:public"],
    tags = ["manual"],
)

rocq_module(
    name = "Completeness",
    includes = [
        "internal/Completeness/Construction/certify_leaf.v",
        "internal/Completeness/Issuance/read_encoded.v",
        "machinery/Completeness/MutualInduction.v",
        "machinery/Completeness/SoundnessInduction.v",
        "machinery/Completeness/Tactics.v",
        "machinery/Completeness/terminating_evaluation_is_certifiable.v",
    ],
    namespace = "FixProof.Collector",
    deps = [
        "//fix/proof/evaluation:Adequacy",
        "//fix/proof/semantics:ApplyTree",
        "//fix/proof/semantics:Handle",
        ":Encoding",
        ":Exchanges",
        ":Matching",
    ],
)

rocq_module(
    name = "Encoding",
    includes = [
        "internal/Encoding/Authors.v",
        "internal/Encoding/Codes.v",
        "machinery/Encoding/decode_authenticates.v",
        "machinery/Encoding/encode_decode.v",
    ],
    namespace = "FixProof.Collector",
    deps = [
        "//fix/proof/semantics:Handle",
        ":Matching",
    ],
)

rocq_module(
    name = "Exchanges",
    includes = [
        "internal/Exchanges/Authority.v",
        "internal/Exchanges/Checking/read_sound.v",
        "internal/Exchanges/Checking/substitute_force.v",
        "machinery/Exchanges/Equality.v",
        "machinery/Exchanges/check_sound.v",
        "machinery/Exchanges/issue_conditional.v",
        "machinery/Exchanges/reconstruct_tag_sound.v",
        "machinery/Exchanges/reconstruction_validated_sound.v",
    ],
    namespace = "FixProof.Collector",
    deps = [
        "//fix/proof/semantics:ApplyTree",
        "//fix/proof/semantics:Handle",
        ":Encoding",
        ":Logic",
        ":Matching",
    ],
)

rocq_module(
    name = "Logic",
    includes = [
        "internal/Logic/Primitives.v",
        "internal/Logic/Rules.v",
        "machinery/Logic/MutualInduction.v",
        "machinery/Logic/coupon_blob_same_data.v",
        "machinery/Logic/coupon_sound.v",
    ],
    namespace = "FixProof.Collector",
    deps = [
        "//fix/proof/equivalence:Closure",
        "//fix/proof/equivalence:Indistinguishability",
        "//fix/proof/semantics:ApplyTree",
        "//fix/proof/semantics:Handle",
    ],
)

rocq_module(
    name = "Matching",
    namespace = "FixProof.Collector",
    deps = [
        "//fix/proof/semantics:Handle",
    ],
)

rocq_module(
    name = "Preservation",
    includes = [
        "machinery/Preservation/evaluation_preserves_authority.v",
    ],
    namespace = "FixProof.Collector",
    deps = [
        "//fix/proof/semantics:ApplyTree",
        "//fix/proof/semantics:Handle",
        ":Exchanges",
    ],
)

test_suite(
    name = "check",
    tests = [
        ":Completeness_check",
        ":Encoding_check",
        ":Exchanges_check",
        ":Logic_check",
        ":Matching_check",
        ":Preservation_check",
    ],
    tags = ["manual", "proof"],
)
