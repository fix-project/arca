load("@rules_python//python:defs.bzl", "py_binary")
load("//build:rocq.bzl", "rocq_module")

package(default_visibility = ["//fix/proof:__subpackages__"])

rocq_module(
    name = "Binary",
    namespace = "FixProof.Collector.wasm",
    src = ":binary_source",
)

rocq_module(
    name = "Backend",
    namespace = "FixProof.Collector.wasm",
    deps = [
        "//fix/proof/shell:ABI",
        "//fix/proof/shell:Descriptors",
        "//fix/proof/shell:Host",
        "//fix/proof/shell:Memory",
        "//fix/proof/shell:Privileged",
        "//fix/proof/collector:Encoding",
        "//fix/proof/collector:Exchanges",
        "//fix/proof/collector:Matching",
        "//fix/proof/semantics:ApplyTree",
        "//fix/proof/semantics:Handle",
        "//fix/proof/support:BlobInteger",
        "//fix/proof/support:WasmNatural",
        ":Binary",
        ":Execution",
        ":Guards",
        ":Layout",
    ],
)

rocq_module(
    name = "Execution",
    namespace = "FixProof.Collector.wasm",
    deps = [
        "//fix/proof/shell:ABI",
        "//fix/proof/shell:Host",
        "//fix/proof/collector:Matching",
        "//fix/proof/semantics:ApplyTree",
        "//fix/proof/semantics:Handle",
        ":Binary",
        ":Layout",
    ],
)

rocq_module(
    name = "Guards",
    namespace = "FixProof.Collector.wasm",
    deps = [
        "//fix/proof/shell:ABI",
        "//fix/proof/shell:Host",
        "//fix/proof/collector:Matching",
        "//fix/proof/semantics:ApplyTree",
        "//fix/proof/semantics:Handle",
        "//fix/proof/support:WasmNatural",
        ":Binary",
        ":Execution",
        ":Layout",
    ],
)

rocq_module(
    name = "Layout",
    namespace = "FixProof.Collector.wasm",
    deps = [
        "//fix/proof/shell:ABI",
        "//fix/proof/semantics:Handle",
        "//fix/proof/support:WasmNatural",
        ":Binary",
    ],
)

rocq_module(
    name = "Entry",
    namespace = "FixProof.Collector.wasm",
    deps = [":Backend"],
    includes = [
        "Support.v",
        "Checked.v",
        "Resources.v",
        "Witnesses.v",
        "Acceptance.v",
        "Validation.v",
        "TreeLoop.v",
        "Rules.v",
        "DispatchSupport.v",
        "GuardValidation.v",
        "Constructors.v",
        "Integer.v",
        "Premise.v",
        "MappedValidation.v",
        "Authentication.v",
        "AuthorityGuard.v",
        "Authority.v",
        "AuthorityValidation.v",
        "TreeValidation.v",
        "BinaryRules.v",
        "ForceRules.v",
        "StrictValidation.v",
        "Dispatch.v",
        "Prefixes.v",
        "BinaryPrefixValidation.v",
        "ForceValidation.v",
        "Reconstruction.v",
        "ThinkValidation.v",
        "IssuePrefix.v",
        "DirectValidation.v",
        "CongruenceValidation.v",
        "ThunkValidation.v",
        "SubstitutionValidation.v",
        "ResultValidation.v",
        "NativeDispatch.v",
        "Resolution.v",
        "Exchange.v",
        "CollectPrefix.v",
        "Issuance.v",
        "Output.v",
        "Collect.v",
        "EntryFields.v",
        "EntryPrefix.v",
        "EntryExecution.v",
        "AuthorityPolicy.v",
        "ReconstructionValidation.v",
        "TreeEntryExecution.v",
        "NativeSuccess.v",
        "BinarySuccess.v",
        "ForceSuccess.v",
        "Export.v",
        "Refinement.v",
    ],
)

test_suite(
    name = "check",
    tests = [":Entry_check", ":Binary_check", ":Backend_check", ":Execution_check", ":Guards_check", ":Layout_check"],
    tags = ["manual", "proof"],
)

py_binary(
    name = "generate_binary",
    srcs = ["generate.py"],
    main = "generate.py",
    tags = ["manual"],
)

genrule(
    name = "binary_source",
    srcs = ["//fix/proof/collector:wasm"],
    outs = ["Binary.v"],
    tools = [":generate_binary"],
    cmd = "$(execpath :generate_binary) $(location //fix/proof/collector:wasm) $@",
    tags = ["manual"],
)
