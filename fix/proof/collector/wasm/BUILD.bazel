load("@rules_python//python:defs.bzl", "py_binary")
load("//build:rocq.bzl", "rocq_module")

package(default_visibility = ["//fix/proof:__subpackages__"])

rocq_module(
    name = "Binary",
    namespace = "FixProof.Collector.wasm",
    src = ":binary_source",
)

rocq_module(
    name = "Backend",
    namespace = "FixProof.Collector.wasm",
    deps = [
        "//fix/proof/shell:ABI",
        "//fix/proof/shell:Descriptors",
        "//fix/proof/shell:Host",
        "//fix/proof/shell:Memory",
        "//fix/proof/shell:Privileged",
        "//fix/proof/collector:Encoding",
        "//fix/proof/collector:Exchanges",
        "//fix/proof/collector:Matching",
        "//fix/proof/semantics:ApplyTree",
        "//fix/proof/semantics:Handle",
        "//fix/proof/support:BlobInteger",
        "//fix/proof/support:WasmNatural",
        ":Binary",
        ":Execution",
        ":Guards",
        ":Layout",
    ],
)

rocq_module(
    name = "Execution",
    includes = [
        "machinery/Execution.v",
    ],
    namespace = "FixProof.Collector.wasm",
    deps = [
        "//fix/proof/shell:ABI",
        "//fix/proof/shell:Host",
        "//fix/proof/collector:Matching",
        "//fix/proof/semantics:ApplyTree",
        "//fix/proof/semantics:Handle",
        ":Binary",
        ":Layout",
    ],
)

rocq_module(
    name = "Guards",
    includes = [
        "machinery/Guards.v",
    ],
    namespace = "FixProof.Collector.wasm",
    deps = [
        "//fix/proof/shell:ABI",
        "//fix/proof/shell:Host",
        "//fix/proof/collector:Matching",
        "//fix/proof/semantics:ApplyTree",
        "//fix/proof/semantics:Handle",
        "//fix/proof/support:WasmNatural",
        ":Binary",
        ":Execution",
        ":Layout",
    ],
)

rocq_module(
    name = "Layout",
    includes = [
        "machinery/Layout.v",
    ],
    namespace = "FixProof.Collector.wasm",
    deps = [
        "//fix/proof/shell:ABI",
        "//fix/proof/semantics:Handle",
        "//fix/proof/support:WasmNatural",
        ":Binary",
    ],
)

