load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "control",
    srcs = ["lib.rs", "state.rs", "core_loop.rs"],
    crate_root = "lib.rs",
    crate_name = "scheduler_control",
    deps = ["//fix/scheduler/dependencies"],
    edition = "2024",
)

rust_test(
    name = "tests",
    deps = ["//fix/scheduler/dependencies"],
    srcs = ["lib.rs", "state.rs", "core_loop.rs", "tests.rs"],
    crate_root = "lib.rs",
    edition = "2024",
)
