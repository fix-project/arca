load("//programs/fix:defs.bzl", "fix_rust_program")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "sdk",
    crate_name = "fixscheduler",
    edition = "2024",
    srcs = glob(["src/**/*.rs"]),
    deps = ["//fix/handle", "//fix/sdk:sdk_import", "//fix/remote:transport", "//fix/remote:protocol", "@crates//:embedded-io", "@crates//:postcard", "@crates//:spin"],
    target_compatible_with = ["@platforms//cpu:wasm32"],
)

rust_test(
    name = "distributed_test",
    srcs = ["tests/distributed.rs"],
    edition = "2024",
    deps = ["//fix/handle", "//fix/repository", "//fix/remote", "//fix/remote:testing", "//fix/certificates", "@crates//:hex"],
    data = ["//programs/fix/schedulers:parallel_elf", "//programs/fix/schedulers:distributed_elf", "//programs/fix/schedulers:serial_elf", "//programs/fix/schedulers:onepass_elf", "//programs/fix/schedulers:hint_elf", "//programs/fix/schedulers:advisor_elf", "//bootstrap:seed_tool", "//fix/cli:fix", "//fix/proof/collector:collector_elf", "//programs/fix:compile_elf", "//programs/fix:addblob_elf", ":fanout_elf", ":work_elf"],
    rustc_env = {
        "DISTRIBUTED": "$(rootpath //programs/fix/schedulers:distributed_elf)",
        "ONEPASS": "$(rootpath //programs/fix/schedulers:onepass_elf)",
        "HINT": "$(rootpath //programs/fix/schedulers:hint_elf)",
        "ADVISOR": "$(rootpath //programs/fix/schedulers:advisor_elf)",
        "SERIAL": "$(rootpath //programs/fix/schedulers:serial_elf)",
        "PARALLEL": "$(rootpath //programs/fix/schedulers:parallel_elf)",
        "SEED": "$(rootpath //bootstrap:seed_tool)",
        "FIX": "$(rootpath //fix/cli:fix)",
        "COLLECTOR": "$(rootpath //fix/proof/collector:collector_elf)",
        "COMPILER": "$(rootpath //programs/fix:compile_elf)",
        "ADD": "$(rootpath //programs/fix:addblob_elf)",
        "WORK": "$(rootpath :work_elf)",
        "FANOUT": "$(rootpath :fanout_elf)",
    },
    size = "large",
    timeout = "moderate",
    tags = ["kvm", "local"],
)

rust_test(
    name = "tasks_test",
    srcs = ["tests/tasks.rs", "src/executor/task.rs"],
    crate_root = "tests/tasks.rs",
    edition = "2024",
    size = "small",
    deps = ["@crates//:spin"],
)

rust_test(
    name = "remote_compile_test",
    srcs = ["tests/remote_compile.rs"],
    edition = "2024",
    deps = ["//fix/remote:testing"],
    data = ["//fix/cli:fix", "//bootstrap:seed", "//programs/fix:addblob_module"],
    rustc_env = {
        "FIX": "$(rootpath //fix/cli:fix)",
        "SEED": "$(rootpath //bootstrap:seed)",
        "MODULE": "$(rootpath //programs/fix:addblob_module)",
    },
    size = "large",
    timeout = "moderate",
    tags = ["kvm", "local", "manual"],
)

fix_rust_program(name = "fanout", src = "tests/fanout.rs", artifact_visibility = ["//visibility:public"])

fix_rust_program(name = "work", src = "tests/work.rs", artifact_visibility = ["//visibility:public"])
