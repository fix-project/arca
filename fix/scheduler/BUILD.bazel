load("//build:defs.bzl", "WASM", "fix_procedure")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "sdk",
    crate_name = "fixscheduler",
    edition = "2024",
    srcs = glob(["src/**/*.rs"]),
    deps = ["//fix/sdk:sdk_import"],
    target_compatible_with = ["@platforms//cpu:wasm32"],
)

exports_files(["examples/parallel.rs"])

filegroup(
    name = "parallel_sources",
    srcs = glob(["examples/parallel/*.rs"]),
    visibility = ["//programs/fix:__pkg__"],
)

alias(name = "parallel", actual = "//programs/fix:scheduler_elf")

rust_shared_library(
    name = "serial_wasm",
    srcs = ["examples/serial.rs"],
    crate_root = "examples/serial.rs",
    edition = "2024",
    platform = WASM,
    deps = [":sdk", "//fix/sdk:sdk_import", "@crates//:dlmalloc"],
)
fix_procedure(name = "serial", wasm = ":serial_wasm", memories = 4, tables = 4)

rust_shared_library(
    name = "advisor_wasm",
    srcs = ["tests/advisor.rs"],
    crate_root = "tests/advisor.rs",
    edition = "2024",
    platform = WASM,
    deps = ["//fix/sdk"],
)
fix_procedure(name = "advisor", wasm = ":advisor_wasm", memories = 3, tables = 3)

rust_shared_library(
    name = "unavailable_advisor_wasm",
    srcs = ["tests/unavailable.rs"],
    crate_root = "tests/unavailable.rs",
    edition = "2024",
    platform = WASM,
    deps = ["//fix/sdk"],
)
fix_procedure(name = "unavailable_advisor", wasm = ":unavailable_advisor_wasm", memories = 3, tables = 3)
