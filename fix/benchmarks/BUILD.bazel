load("//build/benchmarks:defs.bzl", "benchmark_suite", "guest_benchmark")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library")
load("//fix/sdk:defs.bzl", "fix_cc_wasm")
load("//build:defs.bzl", "GUEST_ONLY", "WASM", "fix_procedure", "wat_module")

package(default_visibility = ["//visibility:public"])

wat_module(name = "invoke_wasm", src = "invoke.wat")
fix_procedure(name = "invoke", wasm = ":invoke_wasm")
wat_module(name = "continuation_wasm", src = "continuation.wat")
fix_procedure(name = "continuation", wasm = ":continuation_wasm")
fix_cc_wasm(name = "descriptor_continuation_wasm", srcs = ["descriptor_continuation.c"])
fix_procedure(name = "descriptor_continuation", wasm = ":descriptor_continuation_wasm")
wat_module(name = "function_effect_wasm", src = "function_effect.wat")
fix_procedure(name = "function_effect", wasm = ":function_effect_wasm")
wat_module(name = "effect_handler_wasm", src = "effect_handler.wat")
fix_procedure(name = "effect_handler", wasm = ":effect_handler_wasm")

rust_shared_library(
    name = "sdk_operations_wasm",
    srcs = ["sdk_operations.rs"],
    platform = WASM,
    deps = ["//fix/sdk"],
)

fix_procedure(
    name = "sdk_operations",
    wasm = ":sdk_operations_wasm",
    memories = 3,
)

rust_library(
    name = "support",
    srcs = ["support.rs"],
    crate_name = "fix_benchmark",
    target_compatible_with = GUEST_ONLY,
    deps = ["//arca/kernel", "//fix/runtime"],
)

guest_benchmark(
    name = "invocation",
    src = "invocation.rs",
    cases = "invocation_cases.rs",
    fixtures = {"INVOKE": ":invoke"},
    deps = [":support", "//fix/runtime"],
)

guest_benchmark(
    name = "continuations",
    src = "continuations.rs",
    cases = "continuation_cases.rs",
    fixtures = {
        "CONTINUATION": ":continuation",
        "DESCRIPTOR_CONTINUATION": ":descriptor_continuation",
        "FUNCTION_EFFECT": ":function_effect",
        "EFFECT_HANDLER": ":effect_handler",
    },
    deps = [":support", "//fix/runtime"],
)

guest_benchmark(
    name = "sdk",
    src = "sdk.rs",
    cases = "sdk_cases.rs",
    fixtures = {"SDK": ":sdk_operations"},
    deps = [":support", "//fix/runtime", "//fix/testing:reference"],
)

guest_benchmark(
    name = "scheduler",
    src = "scheduler.rs",
    cases = "scheduler_cases.rs",
    fixtures = {
        "SCHEDULER": "//programs/fix:scheduler_elf",
        "COLLECTOR": "//fix/proof/collector:collector_elf",
    },
    deps = [":support", "//fix/runtime"],
)

benchmark_suite(
    name = "benchmarks",
    suites = [":invocation", ":continuations", ":sdk", ":scheduler"],
)
