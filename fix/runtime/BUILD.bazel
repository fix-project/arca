load("@rules_rust//rust:defs.bzl", "rust_library")
load("//build:defs.bzl", "GUEST_ONLY", "kernel_program", "kernel_test")

package(default_visibility = ["//visibility:private"])

exports_files(["etc/memmap.ld"], visibility = ["//flatware:__subpackages__"])

DEPS = [
    "//arca/api",
    "//arca/kernel",
    "//arca/abi",
    "//lib/common",
    "//fix/handle",
    "//fix/repository",
    "//fix/storage",
    "//fix/api",
    "@crates//:postcard",
    "//fix/coupon",
    "@crates//:log",
    "@crates//:bytes",
    "@crates//:serde",
    "@crates//:derive_more",
    "@crates//:async-lock",
    "@crates//:hex",
    "@crates//:bitint",
    "@crates//:hashbrown",
]

rust_library(
    name = "runtime",
    visibility = ["//flatware:__subpackages__", "//fix/benchmarks:__pkg__", "//fix/testing:__pkg__"],
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/main.rs",
            "src/tests.rs",
        ],
    ),
    compile_data = ["//programs/fix:identity_elf"],
    crate_name = "fixruntime",
    proc_macro_deps = ["//tools/macros"],
    rustc_env = {"FIX_IDENTITY": "$(execpath //programs/fix:identity_elf)"},
    target_compatible_with = GUEST_ONLY,
    deps = DEPS,
)

kernel_program(
    name = "image",
    visibility = ["//visibility:public"],
    image_visibility = [
        "//tests:__subpackages__",
        "//programs/fix:__subpackages__",
        "//programs/flatware:__subpackages__",
        "//flatware:__pkg__",
        "//fix:__subpackages__",
    ],
    image_name = "image_elf",
    srcs = ["src/main.rs"],
    crate_name = "fixruntime",
    crate_root = "src/main.rs",
    linker_script = "etc/memmap.ld",
    proc_macro_deps = ["//tools/macros"],
    deps = [":runtime"] + DEPS,
)

kernel_test(
    name = "tests",
    timeout = "long",
    visibility = ["//:__pkg__", "//tests:__pkg__"],
    image_visibility = ["//tests:__pkg__"],
    image_name = "test_image",
    srcs = ["src/tests.rs", "tests/api.rs", "tests/advice.rs", "tests/evaluation.rs", "tests/maps.rs", "tests/scheduler.rs"],
    crate_name = "fixruntime",
    crate_root = "src/tests.rs",
    linker_script = "etc/memmap.ld",
    proc_macro_deps = ["//tools/macros"],
    deps = [":runtime", "//fix/preprocessor", "//fix/testing:reference"] + DEPS,
    fixtures = {
        "FIX_WORKER_EVENTS": "//tests/fix:worker_events_native",
        "FIX_CONCURRENT_MAP": "//tests/fix:concurrent_map_native",
        "FIX_SERIAL_SCHEDULER": "//fix/scheduler:serial",
        "FIX_SCHEDULER": "//programs/fix:scheduler_elf",
        "FIX_COLLECTOR": "//fix/proof/collector:collector_elf",
        "FIX_PRIVILEGED": "//tests/fix:privileged_native",
        "FIX_PARSER": "//programs/fix/parser:parser_elf",
        "FIX_EVAL": "//tests/fix:eval_native",
        "FIX_READ_BLOB": "//tests/fix:read_blob_native",
        "FIX_ADVICE": "//tests/fix:advice_native",
        "FIX_ADVICE_CAPTURE": "//tests/fix:advice_capture_native",
        "FIX_EXCEPTION_PARAMETERS": "//tests/fix:exception_parameters_native",
        "FIX_LINEAR_EFFECTS": "//tests/fix:linear_effects_native",
        "FIX_SELECTIVE_LIFTING": "//tests/fix:selective_lifting_native",
        "FIX_CONTINUATION": "//tests/fix:continuation_native",
        "FIX_INDISTINGUISHABILITY": "//tests/fix:indistinguishability_native",
        "FIX_CAPTURE_DETERMINISM": "//tests/fix:capture_determinism_native",
        "FIX_CONTINUATION_STATE": "//tests/fix:continuation_state_native",
        "FIX_SDK_ATTACHMENTS": "//fix/sdk:attachments_native",
        "FIX_SDK_EVAL": "//fix/sdk:eval_native",
        "FIX_TAGGER": "//fix/sdk:tagger_native",
        "FIX_RECURSIVE_LOCAL_ALIASES": "//tests/fix:recursive_local_aliases_native",
        "FIX_LARGE_LOCAL_GRAPH": "//tests/fix:large_local_graph_native",
    },
)

kernel_test(
    name = "descriptor_tests",
    visibility = ["//:__pkg__"],
    srcs = ["tests/descriptors.rs", "tests/evaluation.rs"],
    crate_name = "descriptor_tests",
    crate_root = "tests/descriptors.rs",
    linker_script = "etc/memmap.ld",
    proc_macro_deps = ["//tools/macros"],
    deps = [":runtime"] + DEPS,
    fixtures = {
        "IDENTITY": "//programs/fix:identity_elf",
        "MANY_MEMORIES": "//tests/fix:many_memories_native",
        "MANY_TABLES": "//tests/fix:many_tables_native",
        "MEMORY_BOUNDARY": "//tests/fix:memory_boundary_native",
        "TREE_BYTES": "//tests/fix:tree_bytes_native",
        "BINDINGS": "//fix/sdk:c_bindings_native",
        "CAPTURE": "//tests/fix:capture_determinism_native",
        "PARSER": "//programs/fix/parser:parser_elf",
        "FIX_SERIAL_SCHEDULER": "//fix/scheduler:serial",
        "FIX_SCHEDULER": "//programs/fix:scheduler_elf",
        "FIX_COLLECTOR": "//fix/proof/collector:collector_elf",
    },
)
